# MEXC API anahtarlari — https://www.mexc.com/user/openapi adresinden olustur.
# ONEMLI: "Withdraw/Cekim" yetkisini KAPALI birak; IP kisitlamasina Vultr sunucu IP'ni yaz.
MEXC_KEY=
MEXC_SECRET=

# 1 = emir GONDERMEZ (sanal test) | 0 = GERCEK EMIR (once test_mexc.js + DRY ile birkac gun izle!)
DRY_RUN=1

# islem basina risk (0.005 = %0.5) ve ayni anda maksimum acik pozisyon
RISK_PCT=0.005
MAX_OPEN=3

# kaldirac (isolated) ve pano portu
LEVERAGE=5
PANO_PORT=8080
