# MEXC API anahtarlari — https://www.mexc.com/user/openapi adresinden olustur.
# ONEMLI: "Withdraw/Cekim" yetkisini KAPALI birak; IP kisitlamasina Vultr sunucu IP'ni yaz.
MEXC_KEY=
MEXC_SECRET=

# 1 = emir GONDERMEZ (sanal test) | 0 = GERCEK EMIR (once test_mexc.js + DRY ile birkac gun izle!)
DRY_RUN=1

# islem basina risk ve ayni anda maksimum acik pozisyon
# NOT: kucuk kasada (<100$) min kontrat buyuklugu yuzunden %0.5 risk cogu paritede islem actiramaz.
# 33$ kasa icin %3 (=1$ risk) makul baslangic; kasa buyudukce 0.01 -> 0.005'e dusur.
RISK_PCT=0.03
MAX_OPEN=2

# kaldirac (isolated) ve pano portu
LEVERAGE=5
PANO_PORT=8080
