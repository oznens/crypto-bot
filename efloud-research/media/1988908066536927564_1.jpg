n_owner_results:$R[197]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MTk4ODkwODA2NjUzNjkyNzU2NA==:details:cashtag_entities:0":$R[198]={__id:"client:VHdlZXQ6MTk4ODkwODA2NjUzNjkyNzU2NA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[199]=[0,4],tag:$R[200]={__ref:"U21hcnRUYWc6VEFP"},text:"TAO"},"client:VHdlZXQ6MTk4ODkwODA2NjUzNjkyNzU2NA==:details:cashtag_entities:1":$R[201]={__id:"client:VHdlZXQ6MTk4ODkwODA2NjUzNjkyNzU2NA==:details:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[202]=[221,225],tag:$R[203]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},U21hcnRUYWc6QlRD:$R[204]={__id:"U21hcnRUYWc6QlRD",__typename:"SmartTag",info:$R[205]={__ref:"client:U21hcnRUYWc6QlRD:info"},id:"U21hcnRUYWc6QlRD"},"client:U21hcnRUYWc6QlRD:info":$R[206]={__id:"client:U21hcnRUYWc6QlRD:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[207]={__ref:"client:U21hcnRUYWc6QlRD:info:info"}},"client:U21hcnRUYWc6QlRD:info:info":$R[208]={__id:"client:U21hcnRUYWc6QlRD:info:info",__typename:"FinanceSmartTagInfo",ticker:"BTC"},"client:VHdlZXQ6MTk4ODkwODA2NjUzNjkyNzU2NA==:views":$R[209]={__id:"client:VHdlZXQ6MTk4ODkwODA2NjUzNjkyNzU2NA==:views",__typename:"ViewCountInfo",count:"107208"},"client:VHdlZXQ6MTk4ODkwODA2NjUzNjkyNzU2NA==:note_tweet":$R[210]={__id:"client:VHdlZXQ6MTk4ODkwODA2NjUzNjkyNzU2NA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[211]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg4OTA4MDY2MzI3MTA5NjMy"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTg4OTA4MDY2MzI3MTA5NjMy:$R[212]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg4OTA4MDY2MzI3MTA5NjMy",__typename:"NoteTweetResults",result:$R[213]={__ref:"Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg4OTA4MDY2MzI3MTA5NjMy"},"Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI=":$R[214]={__id:"Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI=",__typename:"NoteTweet",text:"$TAO | Update & Yeni Fikir\n\nGüzel yerden sattıktan sonra yeni alım yeri olarak düşündüğüm $332'nin 2% üzerinden alıcı kitlesi bularak 60% yükseldi.\n\n$332 bölgesi hâlâ önemli konumda. Lakin o analizin yapıldığı esnada $BTC fiyatı kritik bir seviye olan $106.150'nin üzerinde seyrediyordu (market yapısı hâlâ pozitif konumdaydı). \nŞu aşamada ise marketin tamamına temkinli yaklaşılması gerektiği kanaatindeyim. #TAO da malumunuz sert bir yükseliş ile önemli direnç bölgelerimizi avladı. AI projeleri arasında lider konumunda fiyatlanarak bir nevi hareket aksiyonunu evvelden gerçekleştirdi.\n\nBu durumları göz önüne aldığımda yeni bir destek olarak $310'u da alarmlıyorum.\n\nAn itibariyle destek bölgesinin içinde duruyor fiyat ancak güçlü bir yapısı yok. $BTC'nin sideways'ler eşliğinde fiyatlandığı ve zayıflık gösterdiği ilk aşamada $TAO bu bölgelere doğru yeni likidite arayışına girebilir.\n\n$TAOBTC'nin de görünümü parlak değil. Kırmızı çizgiyi tekrar kazanana kadar da satış baskısı alımdan yüksek olacaktır kanaatindeyim.\n\nMarketin yapısının, hem $BTC hem $TAOBTC hem de $ETHBTC nezdinde temkinli olmamızı işaret ettiği çıkarımı ile bahsettiğim bölgelerde confirmation (onay) yapıları gözlemleyerek trade düşüncesinde olmakta fayda var.\n\nTüm bu durumları ele aldığımız zaman direkt alım önermediğimin tekrar altını çizmek isterim. Vaktinizi ayırıp confirmation nedir öğrenmek isterseniz aşağıdaki video size yardımcı olacaktır.\n\n🔗https://t.co/Jg94RShF0F\n\nPozitife evrilen bir yapı gözlemlersek mavi çizginin olduğu bölgeler direnç görevi üstlenebilir.\n\nHerkese bol kazançlar, sağlıklı günler dilerim 🤝",entity_set:$R[215]={__ref:"client:Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI=:entity_set"},id:"Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI="},"client:Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI=:entity_set":$R[216]={__id:"client:Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI=:entity_set",__typename:"EntitySet",hashtags:$R[217]={__refs:$R[218]=["client:Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI=:entity_set:hashtags:0"]},symbols:$R[219]={__refs:$R[220]=["client:Tm90ZVR3ZWV0OjE5ODg5MDgwNjYzMjcxMDk2MzI=:entity_set:symb