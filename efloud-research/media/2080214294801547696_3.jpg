ypename:"FinanceSmartTagInfo",ticker:"XRP"},"client:VHdlZXQ6MjA4MDIxNDI5NDgwMTU0NzY5Ng==:views":$R[265]={__id:"client:VHdlZXQ6MjA4MDIxNDI5NDgwMTU0NzY5Ng==:views",__typename:"ViewCountInfo",count:"76894"},"client:VHdlZXQ6MjA4MDIxNDI5NDgwMTU0NzY5Ng==:note_tweet":$R[266]={__id:"client:VHdlZXQ6MjA4MDIxNDI5NDgwMTU0NzY5Ng==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[267]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDgwMjE0Mjk0NDA3Mzg1MDg4"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDgwMjE0Mjk0NDA3Mzg1MDg4:$R[268]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDgwMjE0Mjk0NDA3Mzg1MDg4",__typename:"NoteTweetResults",result:$R[269]={__ref:"Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDgwMjE0Mjk0NDA3Mzg1MDg4"},"Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=":$R[270]={__id:"Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=",__typename:"NoteTweet",text:"$BTC, $ETH Kısa Rapor Güncellemesi & ripple:native Analiz\n\nMerhabalar,\n\n$BTC ve $ETH tarafında detaylı düşüncelerimi araştırma raporlarında belirttiğim için ekstrem bir durum olmadıkça güncelleme geçmiyorum. Sadece ufak bir güncelleme olsun diye araya #BTC'de ve #ETH'da raporda belirttiğim seviyelerin güncellemesini vereceğim, sonra #XRP analizine devam edeceğim.\n\n$BTC tarafında, raporda belirtilen $62500 desteğinden alım yapıp $63750'de (PWO) ve $65500'de (EQ) realize ettim.\n\n$ETH tarafında beklediğim kırmızı kutunun testi ($1960'lar) geldi ve bu aşamada short için confirmation (onay) yapılarının oluşmasını bekliyorum. Confirmation beklememin sebebi de $ETHBTC'nin hâlâ güçlü durumda olması, bu hadiseye yine raporda değiniyorum.\n\nRaporun tamamını okumak için 👇\n🔗 https://t.co/lYDKOSiCVn\n\nripple:native tarafında ise $1.15 bölgesinin geçilmesiyle $1.20 ve $1.26 olmak üzere 2 adet LTF direnç bölgesi gözüme çarpıyor.\nBahsettiğim bölgelerden verilecek düzeltme sonrası kırmakta zorlandığı $1.15 bölgesi destek görevi üstlenebilir.\n\nŞayet $1.15'in kırılımı bir deviasyon olarak kalır ve $1.13 kaybedilirse $1.095-$1.1 bölgesi kısa vadede destek olarak çalışabileceğini düşündüğüm kısımlardandır. \n\nSon olarak, şimdilik rafta olan ancak oluşması durumunda raftan çıkartmamız gereken bir hatırlatma ile analizleri bitireyim.\n$1.02 bölgesinde yaptığı low'lar büyük düşüş öncesi tutunacağı son dal olarak dikkatimi çekiyor. Bu bölgenin kaybı görülecek olursa hem ripple:native'ye hem de altcoin'lerin geneline çok temkinli yaklaşmakta fayda var. Grafiğinizi açıp sol tarafını günlük zaman diliminde incelerseniz ne demek istediğimi anlayacaksınız.\n\nTrader'lara ve ilgilisine not: Hacimsizliğin ve haberlerin yarattığı manipülatif aksiyonların bu hacimsizlikte fiyata yansıması, klasik yaz sezonu pattern'lerini karşımıza çıkartmaktadır. Bu dönemlerde çok fazla trade almaktan kaçınır, olabildiğince işlemlerimi kısa vade olarak tutarım zira genelde kâr aldığım - işlemlerimi kapattığım yerlere fiyat tekrar uğramakta ve yeni fırsatlar doğurmaktadır. Aksi halde, çoğu paritede vakit ve realize etmediğim pozisyonların potansiyel kârından oluşan nakit kaybı yaşamaktayım. Bu tip dönemlerde büyük kovalamak yerine garantici ilerlemek zihin ve bakiye sağlığı açısından benim için genelde çalışan bir çark olmuştur.\n\nHerkese güzel bir hafta, trade'lerinde bol kazançlar diliyorum.",entity_set:$R[271]={__ref:"client:Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg="},"client:Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=:entity_set":$R[272]={__id:"client:Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=:entity_set",__typename:"EntitySet",hashtags:$R[273]={__refs:$R[274]=["client:Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=:entity_set:hashtags:1","client:Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=:entity_set:hashtags:2"]},symbols:$R[275]={__refs:$R[276]=["client:Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwODAyMTQyOTQ0MDczODUwODg=:entity_set:symbols:1","client:Tm90ZVR3ZWV