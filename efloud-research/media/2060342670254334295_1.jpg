ient:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:details":$R[239]={__id:"client:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:details",__typename:"TBirdData",display_text_range:$R[240]=[14,290],full_text:"@Hadestradess Yok kardeşim, ne sorunu :) Ne kibar adamsın valla ♥️\n\nAslında $DXY nezdinde elim analiz yapmaya gidiyor gidiyor sonra diyorum ki US 2-5-10 Tahvilleri, artışı beklenen enflasyon, faiz indiriminin ertelenecek olması vb parametlerini de ekleyerek çok kapsamlı bir analiz yapayım.",hashtag_entities:$R[241]={__refs:$R[242]=[]},cashtag_entities:$R[243]={__refs:$R[244]=["client:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:details:cashtag_entities:0"]},smarttags:$R[245]={__refs:$R[246]=[]},created_at_ms:1778930185000,self_thread_metadata:null},"client:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:details:cashtag_entities:0":$R[247]={__id:"client:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[248]=[76,80],tag:$R[249]={__ref:"U21hcnRUYWc6RFhZ"},text:"DXY"},U21hcnRUYWc6RFhZ:$R[250]={__id:"U21hcnRUYWc6RFhZ",__typename:"SmartTag",info:$R[251]={__ref:"client:U21hcnRUYWc6RFhZ:info"},id:"U21hcnRUYWc6RFhZ"},"client:U21hcnRUYWc6RFhZ:info":$R[252]={__id:"client:U21hcnRUYWc6RFhZ:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:mention_entities:0":$R[253]={__id:"client:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:mention_entities:0",__typename:"ApiMentionEntity",indices:$R[254]=[0,13],is_unmentioned:null,screen_name:"Hadestradess",id_str:"2007668529752092672"},"client:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:note_tweet":$R[255]={__id:"client:VHdlZXQ6MjA1NTYwODMwMTI5NTk4NTE0MA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[256]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDU1NjA4MzAxMDkwNDAyMzA0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDU1NjA4MzAxMDkwNDAyMzA0:$R[257]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDU1NjA4MzAxMDkwNDAyMzA0",__typename:"NoteTweetResults",result:$R[258]={__ref:"Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDU1NjA4MzAxMDkwNDAyMzA0"},"Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ=":$R[259]={__id:"Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ=",__typename:"NoteTweet",text:"Yok kardeşim, ne sorunu :) Ne kibar adamsın valla ♥️\n\nAslında $DXY nezdinde elim analiz yapmaya gidiyor gidiyor sonra diyorum ki US 2-5-10 Tahvilleri, artışı beklenen enflasyon, faiz indiriminin ertelenecek olması vb parametlerini de ekleyerek çok kapsamlı bir analiz yapayım. Bunları birleştireyim derken bi türlü yapamadım :)\n\nFikirlerimi kısaca sadece teknik analize dayalı olarak yazmış olayım.\n\n$DXY: https://t.co/jbxfnuNjTl\n\nDestek ve dirençler kısa vadede şimdiye dek güzel çalıştı.\nYeşil kutu kaybedilmedikçe DXY'de bearish değilim.\n\nO bölge kaybedilirse 97.1 seviyesinde alarmım var. Oradaki güçlenme emarelerini izlemek istiyorum. Bu seviyelerden yeniden geri çekilme yaşarsa 98.2 ilk önem arz eden kısım olacak bana kalırsa.\n\nKırmızı çizgili aralığın kırılımında ise yaratacağı bir imbalance olacaktır. Oraya doğru geri çekilmelerde tekrar longlanıp yukarı doğru gidebilir düşüncesindeyim.\n\nEURUSD'de uzun süredir beklediğim bi 1.157 seviyesi var. Oraya fiyat düştüğünde alarmım çalacak. O andan itibaren DXY'de ufak geri çekilmeler gözlemlemeye çalışarak kısa vadeli işlemler de düşünüyorum.",entity_set:$R[260]={__ref:"client:Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ="},"client:Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ=:entity_set":$R[261]={__id:"client:Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ=:entity_set",__typename:"EntitySet",hashtags:$R[262]={__refs:$R[263]=[]},symbols:$R[264]={__refs:$R[265]=["client:Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ=:entity_set:symbols:1"]},smarttags:$R[266]={__refs:$R[267]=[]},urls:$R[268]={__refs:$R[269]=["client:Tm90ZVR3ZWV0OjIwNTU2MDgzMDEwOTA0MDIzMDQ=:entity_set:urls:0"]},user_mentions:$R[270]={__refs: