rs",conversation_owner_results:$R[303]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:details:cashtag_entities:0":$R[304]={__id:"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[305]=[0,4],tag:$R[306]={__ref:"U21hcnRUYWc6RFhZ"},text:"DXY"},"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:views":$R[307]={__id:"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:views",__typename:"ViewCountInfo",count:"78802"},"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:note_tweet":$R[308]={__id:"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[309]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYwMzQyNjY3MTAwMjM3ODI1"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDYwMzQyNjY3MTAwMjM3ODI1:$R[310]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYwMzQyNjY3MTAwMjM3ODI1",__typename:"NoteTweetResults",result:$R[311]={__ref:"Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYwMzQyNjY3MTAwMjM3ODI1"},"Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=":$R[312]={__id:"Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=",__typename:"NoteTweet",text:"$DXY \n\nMerhabalar,\n\nÇok fazla forex parite isteği ve bununla birlikte endeks soruları geliyor. Yakın geçmişte yaptığım açıklamalardan birini alıntılayarak yeni analizde potansiyel senaryolarımı paylaşacağım. Yol haritam bunlar olacak.\n\nÖncelikle grafik üzerindeki notlardan takip edeceğiniz üzere güzel bir akış yakaladım. Buna binaen oluşturduğum işlemleri devam ettiriyorum. Sizin de takibinizdeyse, ufak bir bilgilendirme olsun.\n\nTakip edeceğim senaryolar:\n1) 99.76 bölgesine fiyat çarpıp şu aşamada destek olarak çalışan 99 bölgesi kaybedilirse gerilemenin derinleşmesini bekleyeceğim.\n2) Kırmızı çizgili aralık kazanılırsa o bölgelere doğru geri çekilme sonrası #DXY rallisini göz önünde bulunduracağım.\n3) 98.2 bölgesine geri çekilme gözlemlenirse bu bölgenin kısa vadeli bir destek konumunda olmasını bekleyeceğim.\n4) Yeşil kutulu bölgenin kaybında 97.1 bölgesine geri çekilme ve oradan bir reaksiyon bekleyeceğim.\n\nHerkesin bayramını tekrardan kutlarım, hayırlı cumalar ve şimdiden güzel bir hafta sonu dilerim.",entity_set:$R[313]={__ref:"client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU="},"client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set":$R[314]={__id:"client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set",__typename:"EntitySet",hashtags:$R[315]={__refs:$R[316]=["client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set:hashtags:0"]},symbols:$R[317]={__refs:$R[318]=["client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set:symbols:0"]},smarttags:$R[319]={__refs:$R[320]=[]},urls:$R[321]={__refs:$R[322]=[]},user_mentions:$R[323]={__refs:$R[324]=[]}},"client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set:hashtags:0":$R[325]={__id:"client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[326]=[667,671],text:"DXY"},"client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set:symbols:0":$R[327]={__id:"client:Tm90ZVR3ZWV0OjIwNjAzNDI2NjcxMDAyMzc4MjU=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[328]=[0,4],tag:$R[329]={__ref:"U21hcnRUYWc6RFhZ"},text:"DXY"},"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:grok_translated_post_with_availability":$R[330]={__id:"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:legacy":$R[331]={__id:"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:legacy",__typename:"LegacyTweet",possibly_sensitive:!1,retweeted_status_results:null},"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:edit_control":$R[332]={__id:"client:VHdlZXQ6MjA2MDM0MjY3MDI1NDMzNDI5NQ==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[333]=["2060342670254334295"]},"urt:server:TimelineTimelineEntry:conver