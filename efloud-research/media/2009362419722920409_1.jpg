d:"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:relationship_counts",__typename:"UserRelationshipCounts",followers:177859,following:541},"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:tweet_counts":$R[99]={__id:"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:tweet_counts",__typename:"UserTweetCounts",tweets:56825},"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:privacy":$R[100]={__id:"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:privacy",__typename:"UserPrivacy",protected:!1},"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:verification":$R[101]={__id:"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:verification",__typename:"UserVerification",is_blue_verified:!0,verified_type:null},"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:identity_profile_labels_highlighted_label":$R[102]={__id:"client:VXNlcjoxMDYzOTM5NTA1ODI3MzIzOTA0:identity_profile_labels_highlighted_label",__typename:"HighlightedUserLabelResponse",label:null},"client:VHdlZXQ6MjAwOTM2MjQxOTcyMjkyMDQwOQ==:details":$R[103]={__id:"client:VHdlZXQ6MjAwOTM2MjQxOTcyMjkyMDQwOQ==:details",__typename:"TBirdData",conversation_control:null,created_at_ms:1767904307000,display_text_range:$R[104]=[0,276],self_thread_metadata:null,full_text:"ZAMA NFT Hediyesi (4 Adet)\n\nMerhabalar,\n\nBiliyorsunuz ki bu komünite insanların birbirleri arasında yardımlaşması ve sorunlarını en kaliteli şekilde çözüme kavuşturma üzerine kurulmuştur.\n\nBiz de aranızdaki takipçisi yüksek kişiler olarak, bazı şeylere vesile olabiliyorsak ne https://t.co/AJbSGdrrhb",hashtag_entities:$R[105]={__refs:$R[106]=[]},cashtag_entities:$R[107]={__refs:$R[108]=[]},smarttags:$R[109]={__refs:$R[110]=[]}},"client:VHdlZXQ6MjAwOTM2MjQxOTcyMjkyMDQwOQ==:views":$R[111]={__id:"client:VHdlZXQ6MjAwOTM2MjQxOTcyMjkyMDQwOQ==:views",__typename:"ViewCountInfo",count:"973201"},"client:VHdlZXQ6MjAwOTM2MjQxOTcyMjkyMDQwOQ==:note_tweet":$R[112]={__id:"client:VHdlZXQ6MjAwOTM2MjQxOTcyMjkyMDQwOQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[113]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDA5MzYyNDE5NTYzNTQ4Njcz"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDA5MzYyNDE5NTYzNTQ4Njcz:$R[114]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDA5MzYyNDE5NTYzNTQ4Njcz",__typename:"NoteTweetResults",result:$R[115]={__ref:"Tm90ZVR3ZWV0OjIwMDkzNjI0MTk1NjM1NDg2NzM="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDA5MzYyNDE5NTYzNTQ4Njcz"},"Tm90ZVR3ZWV0OjIwMDkzNjI0MTk1NjM1NDg2NzM=":$R[116]={__id:"Tm90ZVR3ZWV0OjIwMDkzNjI0MTk1NjM1NDg2NzM=",__typename:"NoteTweet",text:"ZAMA NFT Hediyesi (4 Adet)\n\nMerhabalar,\n\nBiliyorsunuz ki bu komünite insanların birbirleri arasında yardımlaşması ve sorunlarını en kaliteli şekilde çözüme kavuşturma üzerine kurulmuştur.\n\nBiz de aranızdaki takipçisi yüksek kişiler olarak, bazı şeylere vesile olabiliyorsak ne mutlu diyerek elimize geçen fırsatları sizlerle paylaşmaya çalışmaktayız.\n\nSonuçları yarın belli olacak şekilde, aramızda olan 4 arkadaşımıza @zama NFT'si hediye edeceğiz.\n\nAşağıda NFT'nin avantajlarından bir kısmını görebilirsiniz.\nBence başlangıç için en tatmin edici olanı; 40.000 adet $ZAMA token'i $0.005 üzerinden alabilecek olmanız. Bu da totalde $55M FVD olarak varsayılabilir.\n\n@Polymarket'e geldiğimizde ise projenin launch'ı için şu aşamada öngörülen fiyat $600M, en büyük olasılık ile: https://t.co/BuyyrFo0Ub\n\nEğer işler yolunda giderse yatırımınız 11x olarak ilerleyebilir. Tabii ki hiçbir şey kesin değil ancak böyle bir fırsatı sizlere sunmak istedik.\n\nŞartlar: TDD üyesi olmak, RT ve beğeni. \n12-14 saat sonra sonuçları açıklarım.\n\nNot: Hediye dağıtımındaki NFT'leri sizlere verebilmemize vesile olan @efebulduk'a teşekkürlerimizi iletiyoruz.\n\nHerkese iyi geceler, bol kazançlar dilerim 🤝",entity_set:$R[117]={__ref:"client:Tm90ZVR3ZWV0OjIwMDkzNjI0MTk1NjM1NDg2NzM=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMDkzNjI0MTk1NjM1NDg2NzM="},"client:Tm90ZVR3ZWV0OjIwMDkzNjI0MTk1NjM1NDg2NzM=:entity_set":$R[118]={__id:"client:Tm90ZVR3ZWV0OjIwMDkzNjI0MTk1NjM1NDg2NzM=:entity_set",__typename:"EntitySet",hashtags:null,symbols:$R[119]={__refs:$R[120]=["client:Tm90ZVR3ZWV0OjIwMDkzNjI0MTk1NjM1NDg2NzM=:e