1MDg1NDI4OTkwMw==:details:cashtag_entities:0":$R[147]={__id:"client:VHdlZXQ6MTk4Mjc2NTQ1MDg1NDI4OTkwMw==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[148]=[0,4],tag:$R[149]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},U21hcnRUYWc6RVRI:$R[150]={__id:"U21hcnRUYWc6RVRI",__typename:"SmartTag",info:$R[151]={__ref:"client:U21hcnRUYWc6RVRI:info"},id:"U21hcnRUYWc6RVRI"},"client:U21hcnRUYWc6RVRI:info":$R[152]={__id:"client:U21hcnRUYWc6RVRI:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[153]={__ref:"client:U21hcnRUYWc6RVRI:info:info"}},"client:U21hcnRUYWc6RVRI:info:info":$R[154]={__id:"client:U21hcnRUYWc6RVRI:info:info",__typename:"FinanceSmartTagInfo",ticker:"ETH"},"client:VHdlZXQ6MTk4Mjc2NTQ1MDg1NDI4OTkwMw==:note_tweet":$R[155]={__id:"client:VHdlZXQ6MTk4Mjc2NTQ1MDg1NDI4OTkwMw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[156]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTgyNzY1NDUwNTY5MTI1ODg4"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTgyNzY1NDUwNTY5MTI1ODg4:$R[157]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTgyNzY1NDUwNTY5MTI1ODg4",__typename:"NoteTweetResults",result:$R[158]={__ref:"Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTgyNzY1NDUwNTY5MTI1ODg4"},"Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=":$R[159]={__id:"Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=",__typename:"NoteTweet",text:"$ETH | LTF Pozisyon Güncellemesi & Yeni Fikirler\n\nMerhabalar, iyi haftalar.\n\nGüncel Durum:\n#ETH nezdinde kalan pozisyonumun %20'sini buradan %12 kâr ve 9.71 R ile kapatmış bulunuyorum.\nBir önceki analizde 3.92 R ile pozisyonumun %80'ini kapatmıştım.\nToplam R'ı hesapladığımda pozisyon 5 R gibi bir kâr ile sonuca ulaşmış durumda.\n\nYeni Fikirler:\nAslında aklımdaki fikir $4310 civarlarında pozisyonumu finalize etmek idi lakin ret aldığı yer de mantıklı bir kısım olduğu için ve daha fazla funding fee ödememek için pozisyonumu kapatmaya karar verdim.\n\nBu sebeple, $4310 bölgesini hâlâ önemsiyorum ve orada oluşabilecek LTF zayıflık emareleri ile spot'larımı hedge'lemek için işleme girebilirim lakin dediğim gibi confirmation arayacağım, direkt işleme girmeyeceğim.\n\nConfirmation nedir diye soranlar olursa alıntıladığım post'tan geriye sarıp yeşil kutudan işleme giriş sebebinin aynısını görüp - okuyabilirler. Ya da daha genel kapsamda öğrenmek isterseniz YouTube video'ma bakabilirsiniz: https://t.co/Jg94RShF0F\n\nWO/MO kesişimi olan bölgenin kaybı ilk fazda tatsızlık yaratmasa bile bir süre sonra PWO kısmına geri çekilmeye sebebiyet verebilir (direkt düşmeyebilir).\nBöyle bir durumda, PWO seviyesinde yine confirmation bakarak işlem alma düşüncesinde olurum.\n\nKısa vadeli düşüncelerim bu şekildedir. Daha uzun vade perspektif ve bakış açısı için son yazdığım raporu okuyabilirsiniz: https://t.co/1zIhdNVHAy\n\nHerkese güzel bir hafta, bol kazançlar dilerim.",entity_set:$R[160]={__ref:"client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set"},id:"Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg="},"client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set":$R[161]={__id:"client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set",__typename:"EntitySet",hashtags:$R[162]={__refs:$R[163]=["client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set:hashtags:0"]},symbols:$R[164]={__refs:$R[165]=["client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set:symbols:0"]},smarttags:null,urls:$R[166]={__refs:$R[167]=["client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set:urls:0","client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set:urls:1"]},user_mentions:$R[168]={__refs:$R[169]=[]}},"client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set:hashtags:0":$R[170]={__id:"client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[171]=[91,95],text:"ETH"},"client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set:symbols:0":$R[172]={__id:"client:Tm90ZVR3ZWV0OjE5ODI3NjU0NTA1NjkxMjU4ODg=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[173]=[0,4],tag:$R[174]={__r