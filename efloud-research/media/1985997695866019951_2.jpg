6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:details",__typename:"TBirdData",conversation_control:$R[187]={__ref:"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:details:conversation_control"},created_at_ms:1762333723000,display_text_range:$R[188]=[0,282],self_thread_metadata:null,full_text:"$ETH | Destek &amp; Direnç Güncellemesi\n\nMerhabalar,\n\nFiyat, araştırma raporunda verdiğim destek bölgesi olan $3150'den reaksiyon aldı (grafik üzerindeki nottan teyit edebilirsiniz) lakin YO (Yearly Open) kazanılmadıkça pariteye dair sıkıntılar devam edecektir.\n\nFiyatın YO kazanımı https://t.co/M2Czeed9Ay",hashtag_entities:$R[189]={__refs:$R[190]=[]},cashtag_entities:$R[191]={__refs:$R[192]=["client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:details:cashtag_entities:0"]},smarttags:$R[193]={__refs:$R[194]=[]}},"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:details:conversation_control":$R[195]={__id:"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[196]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:details:cashtag_entities:0":$R[197]={__id:"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[198]=[0,4],tag:$R[199]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:views":$R[200]={__id:"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:views",__typename:"ViewCountInfo",count:"68723"},"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:note_tweet":$R[201]={__id:"client:VHdlZXQ6MTk4NTk5NzY5NTg2NjAxOTk1MQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[202]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1OTk3Njk1Njg5ODU0OTc2"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTg1OTk3Njk1Njg5ODU0OTc2:$R[203]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1OTk3Njk1Njg5ODU0OTc2",__typename:"NoteTweetResults",result:$R[204]={__ref:"Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1OTk3Njk1Njg5ODU0OTc2"},"Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY=":$R[205]={__id:"Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY=",__typename:"NoteTweet",text:"$ETH | Destek & Direnç Güncellemesi\n\nMerhabalar,\n\nFiyat, araştırma raporunda verdiğim destek bölgesi olan $3150'den reaksiyon aldı (grafik üzerindeki nottan teyit edebilirsiniz) lakin YO (Yearly Open) kazanılmadıkça pariteye dair sıkıntılar devam edecektir.\n\nFiyatın YO kazanımı sonrası ilk kritik direnci, kaybı sonrası çöküş beklediğimiz $3490 bölgesidir. İkincisi de $3840 bölgesidir.\n\nFiyatın güncel olarak destek bulduğu bölgesinin kaybı ise $2810 ve $2640 bölgelerini sırasıyla gündeme getirebilir.\n\nMarket trendi ve $ETHBTC paritesini göz önünde bulundurulduğunda destek bölgelerinden direkt alım yapmak yerine LTF'lerde confirmation (onay) mekanizmaları gözlemlemek veya dirençlerin desteğe evrilmesini beklemek daha uygun olacaktır.\n\nNot: Alıntıladığım analiz sonrası HTF desteklerimin hiçbirinde LTF confirmation'lar görmediğim için işlem almadım. Bundan dolayı trend tersi işlemler alma eğiliminde olsam bile zarara uğramadım. Confirmation'ın önemini bir kere daha hatırlatmış olayım. İlgili konunun YouTube video'sunu da buraya bırakıyorum: https://t.co/LDkhCVfABr\n\nHerkese güzel bir ay & hafta dilerim.",entity_set:$R[206]={__ref:"client:Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY=:entity_set"},id:"Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY="},"client:Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY=:entity_set":$R[207]={__id:"client:Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY=:entity_set",__typename:"EntitySet",hashtags:$R[208]={__refs:$R[209]=[]},symbols:$R[210]={__refs:$R[211]=["client:Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY=:entity_set:symbols:1"]},smarttags:null,urls:$R[212]={__refs:$R[213]=["client:Tm90ZVR3ZWV0OjE5ODU5OTc2OTU2ODk4NTQ5NzY=:entity_set:urls:0"]},user_mentions:$R[214]={__refs:$R[215]=[]}},"client:Tm90ZVR3ZWV0OjE5ODU5OT