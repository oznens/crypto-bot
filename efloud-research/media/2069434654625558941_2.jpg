,"client:VHdlZXQ6MjA2NzY3NzcyMjEzMDY2NTc4MQ==:details:cashtag_entities:3":$R[192]={__id:"client:VHdlZXQ6MjA2NzY3NzcyMjEzMDY2NTc4MQ==:details:cashtag_entities:3",__typename:"ApiTagEntity",indices:$R[193]=[148,154],tag:$R[194]={__ref:"U21hcnRUYWc6QlRDLkQ="},text:"BTC.D"},"U21hcnRUYWc6QlRDLkQ=":$R[195]={__id:"U21hcnRUYWc6QlRDLkQ=",__typename:"SmartTag",info:$R[196]={__ref:"client:U21hcnRUYWc6QlRDLkQ=:info"},id:"U21hcnRUYWc6QlRDLkQ="},"client:U21hcnRUYWc6QlRDLkQ=:info":$R[197]={__id:"client:U21hcnRUYWc6QlRDLkQ=:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MjA2NzY3NzcyMjEzMDY2NTc4MQ==:mention_entities:0":$R[198]={__id:"client:VHdlZXQ6MjA2NzY3NzcyMjEzMDY2NTc4MQ==:mention_entities:0",__typename:"ApiMentionEntity",indices:$R[199]=[53,64],is_unmentioned:null,screen_name:"OKXTurkiye",id_str:"1159720348302135296"},"client:VHdlZXQ6MjA2NzY3NzcyMjEzMDY2NTc4MQ==:note_tweet":$R[200]={__id:"client:VHdlZXQ6MjA2NzY3NzcyMjEzMDY2NTc4MQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[201]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY3Njc3NzIxOTYyOTAxNTA0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDY3Njc3NzIxOTYyOTAxNTA0:$R[202]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY3Njc3NzIxOTYyOTAxNTA0",__typename:"NoteTweetResults",result:$R[203]={__ref:"Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY3Njc3NzIxOTYyOTAxNTA0"},"Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=":$R[204]={__id:"Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=",__typename:"NoteTweet",text:"Haftalık Araştırma Raporu & Atan Alır Etkinliği\n\n@OKXTurkiye ile birlikte hazırlamış olduğumuz son araştırma raporumuzda $BTC, $ETH, $ETHBTC ve $BTC.D paritelerinin yüksek ve düşük zaman dilimlerini (HTF & LTF) içeren analizlerine alıntıladığım post üzerinden erişebilirsiniz.  \n\nZincir üstü verileri için değerli @KardesBaris'ın da yorumları aynı araştırma raporu içerisinde yer almaktadır.  \n\nAyrıca son zamanlarda Dünya Kupası aktivitelerine ayak uydurarak Atan Alır etkinliği düzenleyen OKX TR, başarılı bir işe imza atmış. Şu sıralar keyifle kullanıyorum ve takip ettiğim maçlara herhangi bir para vs. yatırmadan sadece kim kazanır diye tahmin ederek XP biriktiriyorum. \nYaptığım tahminler sonucu en son 133. sıradaydım (futboldan anladığım pek söylenemez :D) ve hiç yoktan 7000 TL değerinde #BTC XP'si birikmişti. İşin eğlencesi yanında böyle bir sunumun olması gerçekten keyif verici, bir nebze de kafa dağıtıcı aktivite :)\n\nSiz de ücretsiz şekilde Dünya Kupası boyunca bu etkinliğe adım atmak isterseniz aşağıdaki link'ten uygulamayı indirebilirsiniz.\n\n🔗 https://t.co/Ve654oVSkU\n\nAyrıca Dünya Kupası vesilesiyle bana gönderdikleri hediyeler için de fırsatını bulmuşken @OKXTurkiye'ye teşekkür etmek isterim.\n\nRaporun faydalı, etkinliğin eğlenceli geçmesi temennilerimle 🤝",entity_set:$R[205]={__ref:"client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ="},"client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set":$R[206]={__id:"client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set",__typename:"EntitySet",hashtags:$R[207]={__refs:$R[208]=["client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:hashtags:0"]},symbols:$R[209]={__refs:$R[210]=["client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:symbols:3"]},smarttags:$R[211]={__refs:$R[212]=[]},urls:$R[213]={__refs:$R[214]=["client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:urls:0"]},user_mentions:$R[215]={__refs:$R[216]=["client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:user_mentions:0","client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:user_mentions:1","client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:user_mentions:2"]}},"client:Tm90ZVR3ZWV0OjIwNjc2Nzc3MjE5NjI5MDE1MDQ=:entity_set:hashtags:0":