l_entities:2":$R[224]={__id:"client:VHdlZXQ6MjAzNDI2NTkzMjY2MzU5MTAzNA==:url_entities:2",__typename:"UrlsEntity",display_url:"tradingview.com/x/TKfcyj6t/",expanded_url:"https://www.tradingview.com/x/TKfcyj6t/",indices:$R[225]=[229,252],url:"https://t.co/9HBcNIFN56"},"client:VHdlZXQ6MjAzNDI2NTkzMjY2MzU5MTAzNA==:note_tweet":$R[226]={__id:"client:VHdlZXQ6MjAzNDI2NTkzMjY2MzU5MTAzNA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[227]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM0MjY1OTMyNDM3MDQ1MjQ4"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDM0MjY1OTMyNDM3MDQ1MjQ4:$R[228]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM0MjY1OTMyNDM3MDQ1MjQ4",__typename:"NoteTweetResults",result:$R[229]={__ref:"Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM0MjY1OTMyNDM3MDQ1MjQ4"},"Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=":$R[230]={__id:"Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=",__typename:"NoteTweet",text:"Tabii ki. Hatta senin vesilen ile detaylı bir cevap atmış olayım. Görenler bu post üzerinden referans alabilirler düşüncelerimi\n\n$BTC LTF: https://t.co/4P9CXpga0M\n$ETH LTF: https://t.co/y4hlWaOcmF\n$SOL HTF: https://t.co/TQlLneg35D\n\nÖzellikle $ETH tarafında düşebileceği bir tık alan daha var gibi duruyor. $BTC ise $72K'larda korunur düşüncem vardı (RH kaybedilmedikçe sorun görmüyorum).\n\nBunlardan sebep belki bir tık daha gerileme görülebilir ($BTC tarafında $71.4K'ler gibi) ancak özellikle HTF'de güzel dirençlerin egale edildiği düşüncesindeyim.\nUmarım klasik bayram çakışı yaşamayız.\n\nNot: Vadeli tarafta işlemim bulunmuyor. Hem #ETH hem #BTC tarafında spot alımlarım mevcut. Bir süre TR'de ve bilgisayarımın başında aktif olarak olmayacağım ve market ağır aksak ilerlediği için büyük risklerden ziyade kafa rahatlığı - biraz da tatil maksatlı yaklaşımlar izliyorum. #SOL işlemim de var bu arada, onu da paylaşmıştım. İlk büyük satışımı $97'den (kırmızı kesikli çizgi ve biraz üzeri) yaptım. Before (öncesi) için aşağıdaki paylaşımı referans alabilirsiniz.\n\nHerkes kolaylıklar dilerim.",entity_set:$R[231]={__ref:"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg="},"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set":$R[232]={__id:"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set",__typename:"EntitySet",hashtags:$R[233]={__refs:$R[234]=["client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:1","client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:2"]},symbols:$R[235]={__refs:$R[236]=["client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:symbols:3","client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:symbols:4"]},smarttags:null,urls:$R[237]={__refs:$R[238]=["client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:urls:0","client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:urls:1","client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:urls:2"]},user_mentions:$R[239]={__refs:$R[240]=[]}},"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:0":$R[241]={__id:"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[242]=[635,639],text:"ETH"},"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:1":$R[243]={__id:"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:1",__typename:"ApiTagEntity",indices:$R[244]=[644,648],text:"BTC"},"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:2":$R[245]={__id:"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:hashtags:2",__typename:"ApiTagEntity",indices:$R[246]=[873,877],text:"SOL"},"client:Tm90ZVR3ZWV0OjIwMzQyNjU5MzI0MzcwNDUyNDg=:entity_set:symbols:0":$R[247]