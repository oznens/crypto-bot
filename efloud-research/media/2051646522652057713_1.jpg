{__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ3MjU0MDUyNDgwNjE4NDk3"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDQ3MjU0MDUyNDgwNjE4NDk3:$R[185]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ3MjU0MDUyNDgwNjE4NDk3",__typename:"NoteTweetResults",result:$R[186]={__ref:"Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ3MjU0MDUyNDgwNjE4NDk3"},"Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=":$R[187]={__id:"Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=",__typename:"NoteTweet",text:"$BTC / $ETH / $BTC.D Hakkında Genel Bilgilendirme\n\nMerhabalar,\n\nBu hafta reel işlerim sebebiyle biraz yoğundum ve pek aktif olamadım. Fakat önceden beğendiğim ve kullanacağım seviyeleri ilettiğim için sürekli aynı şeyleri yinelemek istemedim.\n\nAşağıya güncel grafiklerimi bırakacağım lakin bahsettiğim senaryolardan ve seviyelerden kısa çaplı bilgilendirmeler vereceğim.\n\nDetaylı analizleri ise akşam @OKXTurkiye'nin yayınlayacağı araştırma raporunda görebilirsiniz.\n\n- #BTC'de $78.000'de satış bildirisi vermiştim. Akabinde %6 düşüş gerçekleşti. Kalan miktarı $80-82.000 bandında satacağımı söylemiştim. Fiyat maalesef o bölgeyi $500 ile sıyırdı ama emirleri dağıtık şekilde bekliyor. Ve $BTC tarafında LTF grafiklere bakınca biraz daha gerileme durumu söz konusu. $ETH ise buna nazaran bir tık daha fazla düşebilir (sebebi $BTC.D anlatımında)\n\n- #ETH'da büyük bir güncellemem olmamıştı. $2000'lerden var olan long'u devam ettirdiğimi iletmiştim. RH bölgesinin direnç olabileceği vurgusunu iletmiştim.\nYeni analizlerde (HTF & LTF) size bir parabolik yapı ve kanal yapısı gösterdim.\nLTF'de RH'ın momentumlu kırılımı ile bu kanal yapısının üst taraflarına doğru ilerlemesi söz konusu olacak. Bu durumu, işlemimi finalize etmek adına takip edeceğim (halihazırda %50 kâr realize edildi).\n\n- $BTC.D önemli bir direncinin altında 10 gün konsolide olduktan sonra o bölgeyi kırdı. Şu aşamada %59.5 bölgesi kaybedilmedikçe altcoin'lerde alınan pozisyonlanmalara dikkat edilip, bir long fırsatı yakalanırsa \"kısa vadeli\" düşünülmesi gerekiyor. Bir üstteki direnci olan %61.5 bölgesinde vereceği zayıflık emareleri sonrası kısa çaplı bir altcoin market canlanması görebiliriz.\n\nTüm detaylar ve farklı senaryolar için akşam yayınlanacak raporu takip edebilirsiniz.\n\nUlusal Egemenlik ve Çocuk Bayramınızı kutluyorum, güzel günler diliyorum.",entity_set:$R[188]={__ref:"client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc="},"client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set":$R[189]={__id:"client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set",__typename:"EntitySet",hashtags:$R[190]={__refs:$R[191]=["client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:hashtags:1"]},symbols:$R[192]={__refs:$R[193]=["client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:symbols:3","client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:symbols:4","client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:symbols:5","client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:symbols:6"]},smarttags:$R[194]={__refs:$R[195]=[]},urls:$R[196]={__refs:$R[197]=[]},user_mentions:$R[198]={__refs:$R[199]=["client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:hashtags:0":$R[200]={__id:"client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[201]=[470,474],text:"BTC"},"client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:hashtags:1":$R[202]={__id:"client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entity_set:hashtags:1",__typename:"ApiTagEntity",indices:$R[203]=[848,852],text:"ETH"},"client:Tm90ZVR3ZWV0OjIwNDcyNTQwNTI0ODA2MTg0OTc=:entit