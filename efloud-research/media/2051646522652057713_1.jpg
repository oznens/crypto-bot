entioned:null,screen_name:"OKXTurkiye"},"client:VHdlZXQ6MjA0NzI1NDA1Mjc3ODQxNDMwMA==:grok_translated_post_with_availability":$R[227]={__id:"client:VHdlZXQ6MjA0NzI1NDA1Mjc3ODQxNDMwMA==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA0NzI1NDA1Mjc3ODQxNDMwMA==:views":$R[228]={__id:"client:VHdlZXQ6MjA0NzI1NDA1Mjc3ODQxNDMwMA==:views",__typename:"ViewCountInfo",count:"98807"},"client:VHdlZXQ6MjA0NzI1NDA1Mjc3ODQxNDMwMA==:counts":$R[229]={__id:"client:VHdlZXQ6MjA0NzI1NDA1Mjc3ODQxNDMwMA==:counts",__typename:"ApiCounts",reply_count:22,favorite_count:484,retweet_count:33,quote_count:1},"client:VHdlZXQ6MjA0NzI1NDA1Mjc3ODQxNDMwMA==:legacy":$R[230]={__id:"client:VHdlZXQ6MjA0NzI1NDA1Mjc3ODQxNDMwMA==:legacy",__typename:"LegacyTweet",possibly_sensitive:!1},"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:counts":$R[231]={__id:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:counts",__typename:"ApiCounts",bookmark_count:86,favorite_count:548,reply_count:40,retweet_count:45,quote_count:1},"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:core":$R[232]={__id:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:core",__typename:"TweetCore",user_results:$R[233]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:details":$R[234]={__id:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:details",__typename:"TBirdData",conversation_control:$R[235]={__ref:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:details:conversation_control"},created_at_ms:1777985623000,display_text_range:$R[236]=[0,281],self_thread_metadata:null,full_text:"$BTC | HTF &amp; LTF Detaylı Güncelleme\n\nMerhabalar,\nBu analizimde en son güncellemelerimden bu yana olan aksiyonlarımdan ve önemli gördüğüm yeni bölgelerden bahsedeceğim.\n\nHTF (Günlük Grafik / İlk Grafik):\n\nGrafikte gördüğünüz $72.000-$73.000 aralığını baz alan yeşil kutulu bölge https://t.co/kvOjoWCEGz",hashtag_entities:$R[237]={__refs:$R[238]=[]},cashtag_entities:$R[239]={__refs:$R[240]=["client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:details:cashtag_entities:0"]},smarttags:$R[241]={__refs:$R[242]=[]}},"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:details:conversation_control":$R[243]={__id:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[244]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:details:cashtag_entities:0":$R[245]={__id:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[246]=[0,4],tag:$R[247]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:views":$R[248]={__id:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:views",__typename:"ViewCountInfo",count:"132138"},"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:note_tweet":$R[249]={__id:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[250]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUxNjQ2NTIyMjg3MDc1MzI4"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDUxNjQ2NTIyMjg3MDc1MzI4:$R[251]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUxNjQ2NTIyMjg3MDc1MzI4",__typename:"NoteTweetResults",result:$R[252]={__ref:"Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUxNjQ2NTIyMjg3MDc1MzI4"},"Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=":$R[253]={__id:"Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=",__typename:"NoteTweet",text:"$BTC | HTF & LTF Detaylı Güncelleme\n\nMerhabalar,\nBu analizimde en son güncellemelerimden bu yana olan aksiyonlarımdan ve önemli gördüğüm yeni bölgelerden bahsedeceğim.\n\nHTF (Günlük Grafik / İlk Grafik):\n\nGrafikte gördüğünüz $72.000-$73.000 aralığını baz alan yeşil kutulu bölge kaybedilmedikçe market yapısının değişimine dair bir bir problem olmadığını ve işlemimi $80.000-$82.000 aralığına kadar taşımak istediğimden bahsettim. Bu minvalde aldığım aksiyonları ve düşüncelerimi grafik üzerindeki notlardan teyit edebilirsiniz.\n\nYaklaşık 2 aydır $65.200 bölgesinden beri muhafaza ettiğim spot pozisyonlarımın büyük kısmını %25 kâr ile parçalı olarak satmaya devam ediyorum.\n\nBu demek değildir ki market düşecek. Ben sadece daha önce aldığım kararı uyguluyorum. Kâr beni mutlu etmiş durumda. Ayrıca bir direnç bölgesine gelmiş olabileceğimizi düşünüyorum.\n\nŞayet bu aralıkta bahsettiğim direnç çalışmazsa, bir sonraki direnç bölgesinin grafikte YO yazan $87500 civarı olabileceği kanaatindeyim. Bu duruma son yayınladığım araştırma raporunda da değindim.\n\nLTF (4 Saatlik Grafik / İkinci Grafik):\n\nGrafikte göreceğiniz üzere bir trend çizgisi mevcut. Bu trend çizgisi ile 4H Arz/Talep Alanı yazan yatay çizgili bölgenin kesişimi olan yerlerde bearish LTF confirmation (onay) yapıları gözlemlersem spot satışlarımın yanında düşüş bazlı vadeli işlemler de düşüneceğim (kısa vadeli).\n\nGrafikte göreceğiniz PWO/WO yazan $78600 bölgesinin kaybıyla, fiyatı MO yazan kısımdaki $76400'de görebiliriz. Bu bölgelerde gözlemeyeceğim confirmation (onay) yapıları ile sattığım ürünleri geri koymayı düşünebilirim. Fakat işlemim bir önceki kadar uzun vadeli (2 ay) sürmez. Daha kısa vadeli bir işlem kurgusuyla ilerlerim.\n\nFiyatın desteğinde başarı gösteremediği bir durum söz konusu olursa ve Old ATH yazan kısmı kaybederse RH yazan kutulu bölge kısa vadeli desteği konumunda olabilir.\n\nNot: Analizlerimde bahsettiğim alanlar/seviyeler kendi gözlemlediğim destek/direnç bölgeleri olup, mutlaka çalışacak gözüyle bakılmamalıdır. Direkt emir atmaktan ziyade alarm kurulup daha düşük zaman dilimlerinde (30 dk, 15 dk) zayıflık/güçlenme emareleri gözlemlendikten sonra bir işlem  kurgusu düşünülmelidir.\n\nNot 2: Siz de benim gibi spot işlemlerinizi @midaskripto üzerinden ilerletmek isterseniz https://t.co/nwoXllERaM adresinden uygulamayı indirip işlemlerinizi sürdürebilirsiniz.\n\nHerkese mutlu, başarılı bir hafta ve bol kazançlar diliyorum.\n\n#işbirliği",entity_set:$R[254]={__ref:"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg="},"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set":$R[255]={__id:"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set",__typename:"EntitySet",hashtags:$R[256]={__refs:$R[257]=["client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:hashtags:0"]},symbols:$R[258]={__refs:$R[259]=["client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:symbols:0"]},smarttags:$R[260]={__refs:$R[261]=[]},urls:$R[262]={__refs:$R[263]=["client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:urls:0"]},user_mentions:$R[264]={__refs:$R[265]=["client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:hashtags:0":$R[266]={__id:"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[267]=[2426,2436],text:"işbirliği"},"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:symbols:0":$R[268]={__id:"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[269]=[0,4],tag:$R[270]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:urls:0":$R[271]={__id:"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"app.midaskripto.com/UmaH/3ggjdwl9",expanded_url:"https://app.midaskripto.com/UmaH/3ggjdwl9",indices:$R[272]=[2275,2298],url:"https://t.co/nwoXllERaM"},"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:user_mentions:0":$R[273]={__id:"client:Tm90ZVR3ZWV0OjIwNTE2NDY1MjIyODcwNzUzMjg=:entity_set:user_mentions:0",__typename:"ApiMentionEntity",indices:$R[274]=[2230,2242],is_unmentioned:null,screen_name:"midaskripto"},"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:grok_translated_post_with_availability":$R[275]={__id:"client:VHdlZXQ6MjA1MTY0NjUyMjY1MjA1NzcxMw==:gr