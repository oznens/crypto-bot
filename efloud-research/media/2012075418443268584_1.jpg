o/4HqLid7f9t",hashtag_entities:$R[139]={__refs:$R[140]=[]},cashtag_entities:$R[141]={__refs:$R[142]=["client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:details:cashtag_entities:0"]},smarttags:$R[143]={__refs:$R[144]=[]},created_at_ms:1748431871000,self_thread_metadata:null},"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:details:cashtag_entities:0":$R[145]={__id:"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[146]=[0,4],tag:$R[147]={__ref:"U21hcnRUYWc6WE1S"},text:"XMR"},U21hcnRUYWc6WE1S:$R[148]={__id:"U21hcnRUYWc6WE1S",__typename:"SmartTag",info:$R[149]={__ref:"client:U21hcnRUYWc6WE1S:info"},id:"U21hcnRUYWc6WE1S"},"client:U21hcnRUYWc6WE1S:info":$R[150]={__id:"client:U21hcnRUYWc6WE1S:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[151]={__ref:"client:U21hcnRUYWc6WE1S:info:info"}},"client:U21hcnRUYWc6WE1S:info:info":$R[152]={__id:"client:U21hcnRUYWc6WE1S:info:info",__typename:"FinanceSmartTagInfo",ticker:"XMR"},"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:note_tweet":$R[153]={__id:"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[154]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTI3Njg5MTAzNTI2ODI1OTg0"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTI3Njg5MTAzNTI2ODI1OTg0:$R[155]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTI3Njg5MTAzNTI2ODI1OTg0",__typename:"NoteTweetResults",result:$R[156]={__ref:"Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTI3Njg5MTAzNTI2ODI1OTg0"},"Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=":$R[157]={__id:"Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=",__typename:"NoteTweet",text:"$XMR | Final Update\n\nMerhabalar,\n\nAnalize Türkçe başladığım için Türkçe bitireyim istedim.\nAlıntıladığım post'dan adım adım geriye sararak grafiğin üzerinde 1-2-3-4 şeklinde etiketlediğim tüm notların olduğu paylaşımları kronolojik olarak gözlemleyebilirsiniz.\n\nAnaliz değildi, paylaşımlardan ve notlardan göreceğiniz üzere direkt sinyaldi.\n\nSizle paylaştığım andan itibaren 111% yükselen, ekleme yapacağımı ilettiğim yerden itibaren de 81% yükselen #XMR işlemimim tamamen sonlamıştır.\n\nSürece ve doğru aksiyonu doğru risk yönetimi ile birleştirmenin nasıl bir şey olduğunun çıktısıdır, istifade edememiş olanlar için bile güzel bir ders/öğreti niteliğindedir.\n\nTekrar bu coin'i ne zaman almayı düşünürsün sorusu da muhtemelen gelebilir. \nŞimdilik değil. Lakin ilk fazda $240-250 arasını alarmlıyorum.\n\nAyrıca bu coin'i, ilk Alpha Trading Summit katılımımda gizlilik projeleri altında değerlendirip bakiyemin bir kısmını ile sürpriz yapabileceğini düşündüğüm için tuttuğumu söyleyerek bir risk almıştım. Oraya katılanlarınız vardı, hatırlayabilirler. Sürpriz yaptı :)\n\nİlk Alpha Trader Summit'deki sunumumu ve değindiğim genel başlıkları gözlemlemek isterseniz: https://t.co/AOQ2sJNfs1\n\nHerkese güzel bir gün dilerim.",entity_set:$R[158]={__ref:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set"},id:"Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ="},"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set":$R[159]={__id:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set",__typename:"EntitySet",hashtags:$R[160]={__refs:$R[161]=["client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:hashtags:0"]},symbols:$R[162]={__refs:$R[163]=["client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:symbols:0"]},smarttags:null,urls:$R[164]={__refs:$R[165]=["client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:urls:0"]},user_mentions:$R[166]={__refs:$R[167]=[]}},"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:hashtags:0":$R[168]={__id:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[169]=[450,454],text:"XMR"},"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:symbols:0":$R[170]={__id:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[171]=[0,4],tag:$R[172]={__ref:"U21hcnRUYW