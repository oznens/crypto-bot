MyMzkwNA=="}},"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details":$R[250]={__id:"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details",__typename:"TBirdData",conversation_control:$R[251]={__ref:"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:conversation_control"},created_at_ms:1770451600000,display_text_range:$R[252]=[0,275],self_thread_metadata:null,full_text:"$BTC | LTF Pozisyon Update\n\nGünaydınlar,\nGrafik üzerinde de görebileceğiniz üzere, RH bölgesinde (kırmızı kutu) LTF (15 dk) confirmation ile işlem alınabileceğinden bahsettim.\n\nBuna binaen oluşturduğum short kurgusunda #BTC işlem aldığım (confirmation'ı sağlayan) yerden %4.5 https://t.co/vuNrUbdx2o",hashtag_entities:$R[253]={__refs:$R[254]=["client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:hashtag_entities:0"]},cashtag_entities:$R[255]={__refs:$R[256]=["client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:cashtag_entities:0"]},smarttags:$R[257]={__refs:$R[258]=[]}},"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:conversation_control":$R[259]={__id:"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[260]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:hashtag_entities:0":$R[261]={__id:"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:hashtag_entities:0",__typename:"ApiTagEntity",indices:$R[262]=[219,223],text:"BTC"},"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:cashtag_entities:0":$R[263]={__id:"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[264]=[0,4],tag:$R[265]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:views":$R[266]={__id:"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:views",__typename:"ViewCountInfo",count:"47839"},"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:note_tweet":$R[267]={__id:"client:VHdlZXQ6MjAyMDA0NjUzOTIzNDY0MDI3NQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[268]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDIwMDQ2NTM5MDc1MjM5OTM2"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDIwMDQ2NTM5MDc1MjM5OTM2:$R[269]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDIwMDQ2NTM5MDc1MjM5OTM2",__typename:"NoteTweetResults",result:$R[270]={__ref:"Tm90ZVR3ZWV0OjIwMjAwNDY1MzkwNzUyMzk5MzY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDIwMDQ2NTM5MDc1MjM5OTM2"},"Tm90ZVR3ZWV0OjIwMjAwNDY1MzkwNzUyMzk5MzY=":$R[271]={__id:"Tm90ZVR3ZWV0OjIwMjAwNDY1MzkwNzUyMzk5MzY=",__typename:"NoteTweet",text:"$BTC | LTF Pozisyon Update\n\nGünaydınlar,\nGrafik üzerinde de görebileceğiniz üzere, RH bölgesinde (kırmızı kutu) LTF (15 dk) confirmation ile işlem alınabileceğinden bahsettim.\n\nBuna binaen oluşturduğum short kurgusunda #BTC işlem aldığım (confirmation'ı sağlayan) yerden %4.5 düşüş, $ETH ise işlem aldığım yerden %3 düşüş yaşadı.\n\nİşlemi, gün için / kısa vadeli kurgular ile oluşturduğum için $BTC'den %50 kâr aldım. #ETH'u ise daha güçlü durduğu ve işlemine geç girdiğim için tamamen kapattım.\n\nİki parite de LTF desteklerine gelmiş durumdalar, bu sebep ile kâr realize ettim. Düşüşün devam edebileceği ve $BTC'de EQ bölgesini ziyaret edebileceğimizi düşündüğüm için pozisyonun yarısını muhafaza ediyorum. Stop->entry yaparak kârımı da garantiye aldım.\n\nDün, ETH ve BTC nezdinde HTF dirençlerine geldiğimizden bahsetmemden, long'larımı kapattığımı belirtmemden ve short kurgumu söylememden ötürü belki işlem düşüncesinde olanlar vardır diye sebepleri-sonuçları ile bir güncelleme yapmak istedim. Umarım bakış açınıza, pozisyonlarınıza katkı sağlamıştır.\n\nHerkese güzel bir hafta sonu dilerim 🤝",entity_set:$R[272]={__ref:"client:Tm90ZVR3ZWV0OjIwMjAwNDY1MzkwNzUyMzk5MzY=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMjAwNDY1MzkwNzUyMzk5MzY="},"client:Tm90ZVR3ZWV0OjIwMjAwNDY1MzkwNzUyMzk5MzY=:entity_set":$R[273]={__id:"client:Tm90ZVR3ZWV0OjIwMjAwNDY1MzkwNzUyMzk5MzY=:entity_set",__typename:"EntitySet",hashtags:$R[274]={__refs:$R[275]=["clie