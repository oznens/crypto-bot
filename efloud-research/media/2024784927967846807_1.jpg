yNDc4NDkyNzk2Nzg0NjgwNw==:details:cashtag_entities:0"]},smarttags:$R[254]={__refs:$R[255]=[]}},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:conversation_control":$R[256]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[257]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:hashtag_entities:0":$R[258]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:hashtag_entities:0",__typename:"ApiTagEntity",indices:$R[259]=[0,6],text:"XU100"},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:cashtag_entities:0":$R[260]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[261]=[13,19],tag:$R[262]={__ref:"U21hcnRUYWc6R0FSQU4="},text:"GARAN"},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:views":$R[263]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:views",__typename:"ViewCountInfo",count:"69758"},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:note_tweet":$R[264]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[265]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI0Nzg0OTI3NDcyODg5ODU2"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDI0Nzg0OTI3NDcyODg5ODU2:$R[266]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI0Nzg0OTI3NDcyODg5ODU2",__typename:"NoteTweetResults",result:$R[267]={__ref:"Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI0Nzg0OTI3NDcyODg5ODU2"},"Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=":$R[268]={__id:"Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=",__typename:"NoteTweet",text:"#XU100 & $GARAN | Güncelleme & Midas Kredi Özelliği\n\nMerhabalar,\n\nDün ciddi bir satış baskısı gören fiyat ile portföyümdeki GYO ve bankacılık sektöründe olan paritelerden kısmi kâr realizasyonu gerçekleştirdim. Yükseliş trendinin bozulduğunu henüz düşünmüyorum, ancak XU100 nezdinde bir şişkinlik olduğu aşikâr. Grafiğimde gördüğünüz yeşil kutulu bölgenin kaybı (güncel talep alanı) fiyatı bir nebze daha geri çekilmeye sebebiyet verebilir. Bu durumda ise Actual Gap yazan kısım alarmlı konumda.\n\nGeçtiğimiz güncellemede $GARAN kısmında 155 seviyesinden bahsetmiştim. Alıntılı post'tan kontrol edebilirsiniz.\n\nFiyat o bölgeye düşüp reaksiyon gösterse de üstte bahsettiğim sert satış baskısı sebebiyle yeni alımlarımı 156.4'den geri vermiş durumdayım.\n\nAyrıca, bu tip kısa vadeli veya gün içi işlemlerde bankada olan paramın müsait olmayışı vb. sebeplerle bazen hızlı aksiyon almam gerektiği durumlarda kullanılabilecek @getmidas'ın kredi sisteminden bahsetmek istiyorum. \n\nTemel olarak sistem, Borsa İstanbul’daki hisse işlemlerinde portföyünü teminat göstererek krediden faydalanıp daha büyük alım gücüyle yatırım yapmaya olanak sağlıyor.\n\nMidas Kredi Temel Özellikleri\nKolay ve hızlı: Midas uygulamasında birkaç tıkla krediyi aktif edebilirsin. Uzun onay süreçleri yok.\nPortföy teminatlı: Kullanabileceğin kredi limiti, portföyündeki varlıkların teminat değerine ve nakit bakiyene göre hesaplanır.\nYüksek alım gücü: Kredi dahil toplam alım gücün; nakit + kredi + portföy teminat değerlerinin toplamına göre yükselir.\nFaiz: Krediye genellikle yıllık %48–%63 civarında bir faiz uygulanır. Ancak aynı gün içinde krediyi kullanıp kapatırsan faiz ücretlendirmesi yapılmaz. Günlükte de faiz oranı %0.18 civarlarına denk geliyor. Yani 10.000 TL'ye günlük yaklaşık 18 TL ödersin. \nAlt limit: Kredili yatırımı aktifleştirebilmek  için portföy değerinin en az ₺75.000 olması gerekir.\n\nÖnemli: Krediyi aktifleştirsen bile kullanmadıkça faiz ödemezsin. Kullandığında da aynı gün kapattığında faiz ödemezsin. Ertesi güne taşırsan, günlük maliyet işlemeye başlar.\n\nDetaylar için: Midas uygulamasında Menü > Yatırım Hesabı > Türk Lirası bölümünden Kredili Yatırım özelliğine bakabilirsiniz.\nMidas uygulamasını indirmek için: https://t.co/KiIzyFAyMd\n\nBu sistemi kullanış şeklim:\nÇoğu kişi kredili işlemi duyunca aklına direkt \"nakitim yok, borçla hisse alayım\" geliyor ama benim kullanımım biraz farklı. Ben bunu daha çok bir köprü gibi görüyorum.\n\nTakip ettiğim bir hissede güzel bir giriş noktası yakaladım diyelim, almam lazım. Ama nakit o an hesapta değil, para piyasası fonunda ya da vadeli hesapta bekliyor. Normal şartlarda o paranın gelmesini bekleyene kadar fiyat çoktan gitmiş oluyor, sen de arkasından bakıyorsun.\n\nKredi limitim varken bu beklemeyi yaşamıyorum. Alımı yapıyorum, 2 gün sonra beklediğim nakit hesaba düştüğünde borcu kapatıyorum. Ödediğim 2-3 günlük faiz, o fırsatı o fiyattan yakalamanın bedeli oluyor. Yani ben krediyi bir kaldıraç aracı olarak değil, bir hızlandırıcı olarak kullanıyorum. Bu kafayla yaklaşınca insanın içi çok daha rahat oluyor açıkçası. Çünkü karşılığı olmayan bir parayı kullanmak, benim için her zaman tedirgin edici.\n\nBurada önemli bir not düşmek istiyorum: Bu tarz bir kullanım \"fırsat değerlendirme\" aracı olarak işe yarayabiliyor, evet. Ama arkasında mutlaka bir planınızın olması gerekiyor. Nakdiniz ne zaman gelecek, borcun vadesi ne, riskiniz ne kadar, bunların hepsini önceden bilmeniz lazım. Kredi sonuçta kredidir. Plansız kullanıldığında hızlandırıcı olmaktan çıkıp sizi zorlayan bir yüke dönüşebilir.\n\nNot: Burada yer alan yatırım bilgileri, yorumları ve tavsiyeleri yatırım danışmanlığı kapsamında değildir. Yatırım danışmanlığı hizmeti, yetkili kuruluşlar tarafından kişilerin risk ve getiri tercihleri dikkate alınarak kişiye özel sunulmaktadır. Burada yer alan bilgiler ise genel nitelikte olup raporda yer alan kişilerin yorum ve görüşlerini içermektedir. Bu tavsiyeler mali durumunuz ile risk ve getiri tercihlerinize uygun olmayabilir. Bu nedenle, sadece burada yer alan bilgilere dayanılarak yatırım kararı verilmesi beklentilerinize uygun sonuçlar doğurmayabilir.\n\n#isbirligi",entity_set:$R[269]={__ref:"client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMjQ3ODQ5M