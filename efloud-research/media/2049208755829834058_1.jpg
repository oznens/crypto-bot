gzNDA1OA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[126]=[0,5],tag:$R[127]={__ref:"U21hcnRUYWc6SFlQRQ=="},text:"HYPE"},"U21hcnRUYWc6SFlQRQ==":$R[128]={__id:"U21hcnRUYWc6SFlQRQ==",__typename:"SmartTag",info:$R[129]={__ref:"client:U21hcnRUYWc6SFlQRQ==:info"},id:"U21hcnRUYWc6SFlQRQ=="},"client:U21hcnRUYWc6SFlQRQ==:info":$R[130]={__id:"client:U21hcnRUYWc6SFlQRQ==:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[131]={__ref:"client:U21hcnRUYWc6SFlQRQ==:info:info"}},"client:U21hcnRUYWc6SFlQRQ==:info:info":$R[132]={__id:"client:U21hcnRUYWc6SFlQRQ==:info:info",__typename:"FinanceSmartTagInfo",ticker:"HYPE"},"client:VHdlZXQ6MjA0OTIwODc1NTgyOTgzNDA1OA==:views":$R[133]={__id:"client:VHdlZXQ6MjA0OTIwODc1NTgyOTgzNDA1OA==:views",__typename:"ViewCountInfo",count:"41228"},"client:VHdlZXQ6MjA0OTIwODc1NTgyOTgzNDA1OA==:note_tweet":$R[134]={__id:"client:VHdlZXQ6MjA0OTIwODc1NTgyOTgzNDA1OA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[135]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ5MjA4NzU1NjYyMDgyMDQ4"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDQ5MjA4NzU1NjYyMDgyMDQ4:$R[136]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ5MjA4NzU1NjYyMDgyMDQ4",__typename:"NoteTweetResults",result:$R[137]={__ref:"Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ5MjA4NzU1NjYyMDgyMDQ4"},"Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=":$R[138]={__id:"Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=",__typename:"NoteTweet",text:"$HYPE\n\nMerhabalar,\n\nKırmızı kutunun üzerinde yapılan sapma ve o bölgenin supply (arz) aksiyonu göstermesi #HYPE açısından tatsız oldu. O bölge kazanılmadan şimdilik lokal top düşüncem var.\n\nKırmızı kutulu bölge bu bağlamda direnç görevi üstlenebilir.\nSatış baskısının devam ettiği senaryoda kısa vadede $36.5 bölgesi dikkatimi çeken bir kısım.\nOrta ve uzun vadede önemsediğim iki destek bölgesi de $31 ve $24 civarıdır.\n\nYakın geçmişte, @dd_finance’in yayınında fiyat $35 civarlarındayken $35 ve $31 bölgelerinin önem arz eden destek kısımları olarak değerlendirebileceğinden bahsetmiştim. $35 bölgesinden yaklaşık %30 yükseliş alarak, fiyat ilerleme kaydetti. Şu aşamada, o kırmızı kesikli çizgili aralığın kaybı olursa, bahsettiğim diğer bölgeleri beklerim.\n\nNot: Yayının kaydını bulamadım, ilgili kısmı bu sebeple kanıt olarak paylaşamıyorum.\n\nHerkese iyi haftalar, trade’lerinde başarılar dilerim.",entity_set:$R[139]={__ref:"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg="},"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set":$R[140]={__id:"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set",__typename:"EntitySet",hashtags:$R[141]={__refs:$R[142]=["client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:hashtags:0"]},symbols:$R[143]={__refs:$R[144]=["client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:symbols:0"]},smarttags:$R[145]={__refs:$R[146]=[]},urls:$R[147]={__refs:$R[148]=[]},user_mentions:$R[149]={__refs:$R[150]=["client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:hashtags:0":$R[151]={__id:"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[152]=[106,111],text:"HYPE"},"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:symbols:0":$R[153]={__id:"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[154]=[0,5],tag:$R[155]={__ref:"U21hcnRUYWc6SFlQRQ=="},text:"HYPE"},"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:user_mentions:0":$R[156]={__id:"client:Tm90ZVR3ZWV0OjIwNDkyMDg3NTU2NjIwODIwNDg=:entity_set:user_mentions:0",__typename:"ApiMentionEntity",indices:$R[157]=[437,448],is_unmentioned:null,screen_name:"dd_finance"},"client:VHdlZXQ6MjA0OTIwODc1NTgyOTgzNDA1OA==:grok_translated_post_with_availability":$R[158]={__id:"client:VHdlZXQ6MjA0OTIwODc1NTgyOTgzNDA1OA==:grok_translated_post_with_availabil