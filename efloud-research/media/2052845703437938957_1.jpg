R[245]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:views":$R[246]={__id:"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:views",__typename:"ViewCountInfo",count:"40921"},"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:note_tweet":$R[247]={__id:"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[248]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODQ1NzAzMzA3OTcyNjA4"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODQ1NzAzMzA3OTcyNjA4:$R[249]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODQ1NzAzMzA3OTcyNjA4",__typename:"NoteTweetResults",result:$R[250]={__ref:"Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODQ1NzAzMzA3OTcyNjA4"},"Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg=":$R[251]={__id:"Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg=",__typename:"NoteTweet",text:"$ETH | LTF - Araştırma Raporu Aksiyon Güncellemesi\n\nMerhabalar,\n\nRaporlarda hem HTF hem de LTF görüşlerimi belirterek bunları efektif şekilde kullanmanızı amaçlamaktayım. Raporlar 2 haftada 1 yayınlandığı için ister istemez süreç boyunca bir sürü hareket gerçekleşmektedir. Buradan önemli seviyelerime gelen fiyatlar sonrası alınabilecek aksiyonları sizlerle paylaşıyorum ki ara hareketleri kaçırmayın - aksiyon aldıysanız aksiyonunuzun devamını getirebilin.\n\nDün yayınlanan raporumda, WO kaybı olursa fiyatın nereye kadar çekileceği ($2270) ve hangi seviyeyi (MO - $2256) kaybetmediği müddetçe aksiyon alınabileceğini ilettim. Hem alıntıladığım post'ta hem de grafik üzerindeki notta bunu görebilirsiniz. An itibariyle bahsedilen seviyeden %2,3 kâr mevcut.\n\nRaporlarda verilen bu bilgileri nasıl kullanabilirsiniz? \n- $2270'den alım yaparsınız. $2256 kaybedilirse stop-loss kullanırsınız. Şayet yükselirse, WO'nun kaybı ile düşmesi beklenen fiyat tekrar WO'ya gelince işleminizi kapatırsınız çünkü orası bir destek konumundayken artık dirence evrilmiştir.\n- Velev ki stop oldunuz, yani $2256 kaybedildi. Bir sonraki desteğinin neresi olduğunu okur ve orada confirmation'lar ararsınız.\n\nHem kâr al/pozisyon kapat uyarısı hem de okuduğunuz bilgileri nasıl kullanabileceğinizi iletmek istedim.\n\nHerkese iyi akşamlar, güzel hafta sonları 🤝",entity_set:$R[252]={__ref:"client:Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg="},"client:Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg=:entity_set":$R[253]={__id:"client:Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg=:entity_set",__typename:"EntitySet",hashtags:$R[254]={__refs:$R[255]=[]},symbols:$R[256]={__refs:$R[257]=["client:Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg=:entity_set:symbols:0"]},smarttags:$R[258]={__refs:$R[259]=[]},urls:$R[260]={__refs:$R[261]=[]},user_mentions:$R[262]={__refs:$R[263]=[]}},"client:Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg=:entity_set:symbols:0":$R[264]={__id:"client:Tm90ZVR3ZWV0OjIwNTI4NDU3MDMzMDc5NzI2MDg=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[265]=[0,4],tag:$R[266]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:grok_translated_post_with_availability":$R[267]={__id:"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:legacy":$R[268]={__id:"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:legacy",__typename:"LegacyTweet",possibly_sensitive:!1,retweeted_status_results:null},"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:edit_control":$R[269]={__id:"client:VHdlZXQ6MjA1Mjg0NTcwMzQzNzkzODk1Nw==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[270]=["2052845703437938957"]},"urt:server:TimelineTimelineEntry:conversationthread-2054550904011894923":$R[271]={__id:"urt:server:TimelineTimelineEntry:conversationthread-2054550904011894923",__typename:"TimelineTimelineEntry",entry_id:"conversationthread-2054550904011894923",sort_index:"2089458006939926518",content:$R[272]={__ref:"client:urt:server:Ti