6MTk5NzI4MDc0MDg5MTg0ODgyNg==:details:conversation_control":$R[379]={__id:"client:VHdlZXQ6MTk5NzI4MDc0MDg5MTg0ODgyNg==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[380]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MTk5NzI4MDc0MDg5MTg0ODgyNg==:views":$R[381]={__id:"client:VHdlZXQ6MTk5NzI4MDc0MDg5MTg0ODgyNg==:views",__typename:"ViewCountInfo",count:"2534"},"client:VHdlZXQ6MTk5NzI4MDc0MDg5MTg0ODgyNg==:note_tweet":$R[382]={__id:"client:VHdlZXQ6MTk5NzI4MDc0MDg5MTg0ODgyNg==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[383]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzQwNzQ1MDMxNjgw"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzQwNzQ1MDMxNjgw:$R[384]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzQwNzQ1MDMxNjgw",__typename:"NoteTweetResults",result:$R[385]={__ref:"Tm90ZVR3ZWV0OjE5OTcyODA3NDA3NDUwMzE2ODA="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzQwNzQ1MDMxNjgw"},"Tm90ZVR3ZWV0OjE5OTcyODA3NDA3NDUwMzE2ODA=":$R[386]={__id:"Tm90ZVR3ZWV0OjE5OTcyODA3NDA3NDUwMzE2ODA=",__typename:"NoteTweet",text:"Japonya’nın Küresel Kırılma Noktası Oluşturması\n\nBu durumu özetleyecek olursam, Japonya uzun yıllar dünyanın ucuz para tedarikçisiydi çünkü kendilerinin sıfır faiz politikası, global carry trade fikrinin omurgasıydı.\nAncak an itibariyle tahvil faizleri 20 sene öncesi fiyatlanması olan %2’ye yaklaştı. Bu da dünya adına bir kırılma noktası oluşturabilir.\n\nBu durumun yaratacağı etki fonlar ve bireysel yatırımcılar bazında ilerlemekte. Profesyonel fonlarda yen carry trade pozisyonlarında çözülmeler küresel bir volatilite artışı yaratabilir. Bireysel yatırımcılar ise Türkiye gibi yüksek faiz oranı olan ülkelere yöneliyorlar.\n\nBir yandan carry trade unwind durumu var (USDJPY), bir yandan da yüksek faizli varlıklara agresif bir giriş var.\n\n3/8",entity_set:$R[387]={__ref:"client:Tm90ZVR3ZWV0OjE5OTcyODA3NDA3NDUwMzE2ODA=:entity_set"},id:"Tm90ZVR3ZWV0OjE5OTcyODA3NDA3NDUwMzE2ODA="}