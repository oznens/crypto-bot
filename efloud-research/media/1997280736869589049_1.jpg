M4OTk4ODg0Mg==:views":$R[444]={__id:"client:VHdlZXQ6MTk5NzI4MDc0NDM4OTk4ODg0Mg==:views",__typename:"ViewCountInfo",count:"1895"},"client:VHdlZXQ6MTk5NzI4MDc0NDM4OTk4ODg0Mg==:note_tweet":$R[445]={__id:"client:VHdlZXQ6MTk5NzI4MDc0NDM4OTk4ODg0Mg==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[446]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzQ0MjAxMTkxNDI0"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzQ0MjAxMTkxNDI0:$R[447]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzQ0MjAxMTkxNDI0",__typename:"NoteTweetResults",result:$R[448]={__ref:"Tm90ZVR3ZWV0OjE5OTcyODA3NDQyMDExOTE0MjQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzQ0MjAxMTkxNDI0"},"Tm90ZVR3ZWV0OjE5OTcyODA3NDQyMDExOTE0MjQ=":$R[449]={__id:"Tm90ZVR3ZWV0OjE5OTcyODA3NDQyMDExOTE0MjQ=",__typename:"NoteTweet",text:"TL’ye Etki ve Çifte Yönlü Makro Sonuçlar\n\nTürkiye’de 3 aylık mevduat getirisi %30+, Japonya’da ise faiz hâlâ %1’in altında. Yani faiz farkı, bir anda dev bir fırsat yaratıyor. Ancak Japonya Merkez Bankası’nın (BoJ) sisteme müdahale etmeye başlaması ile Yen’in güçlenme durumu söz konusu. Bu durum da hem TL pozisyonlarını hem de global risk varlıklarını aynı anda sallayabilir.\n\nİşin tuhaf tarafı şurası; Japon tahvil faizi yükseldikçe küresel likidite daralır. Bu da kripto ve risk piyasalarında volatilite artışı anlamına gelir. Ancak aynı zamanda TL gibi yüksek faiz varlıklarına da para girişi anlamına gelir.\n\nBu durumu biraz daha açacak olursam tek bir makro olayın 2 farklı sonucu olabileceğini ve özellikle kripto tarafı ile ilgilenen bizim gibi yüksek faizli para birimi olan kişileri ekstra ilgilendirebileceğini düşünüyorum. Kripto’da volatilite artışı ve fiyat baskılanması, TL’e para girişi ve likidite artışı.\n\n4/8",entity_set:$R[450]={__ref:"client:Tm90ZVR3ZWV0OjE5OTcyODA3NDQyMDExOTE0MjQ=:entity_set"},id:"Tm90ZVR3ZWV0OjE5OTcyODA3NDQyMDExOTE0MjQ="},"client:Tm90ZVR3ZWV0OjE5OTcyODA3NDQyMDExOTE0MjQ=:entity_set":$R[451]={__id:"client:Tm90ZVR3ZWV0OjE5OTcyODA3NDQyMDExOTE0MjQ=:entity_set",__typenam