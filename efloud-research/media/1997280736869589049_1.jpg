iews":$R[220]={__id:"client:VHdlZXQ6MTk5NzI4MDczMzYyNzQwMDMzMw==:views",__typename:"ViewCountInfo",count:"38649"},"client:VHdlZXQ6MTk5NzI4MDczMzYyNzQwMDMzMw==:note_tweet":$R[221]={__id:"client:VHdlZXQ6MTk5NzI4MDczMzYyNzQwMDMzMw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[222]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzMzNDMwMTczNjk2"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzMzNDMwMTczNjk2:$R[223]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzMzNDMwMTczNjk2",__typename:"NoteTweetResults",result:$R[224]={__ref:"Tm90ZVR3ZWV0OjE5OTcyODA3MzM0MzAxNzM2OTY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk3MjgwNzMzNDMwMTczNjk2"},"Tm90ZVR3ZWV0OjE5OTcyODA3MzM0MzAxNzM2OTY=":$R[225]={__id:"Tm90ZVR3ZWV0OjE5OTcyODA3MzM0MzAxNzM2OTY=",__typename:"NoteTweet",text:"$USDJPY & JP10Y Bond - Bunların Makro Ekonomi, TL ve Kripto’ya Etkisi\n\nMerhabalar,\n\nAlıntıladığım post’ta Japonların defalarca kaybettiği bir savaş olan Türk Lirası alarak carry trade yapma alışkanlıklarını 900.000 TL-Yen kontratı ile tarihi zirveye yakın hale getirdiği yeni bir savaşa girdiklerinin özetini okuyoruz.\n\nArdından, bir diğer incelenmesi gereken önemli gelişme, 10 yıllık japon tahvillerinin son yıllardaki ekstrem artışı ile %1.95 seviyesine yani 2006’daki zirvesine yaklaşmış olduğudur.\n\nPeki bu durumlar ülkemizin para birimini, makro ekonomiyi ve kriptoyu nasıl etkileyebilir?\n\nBu soruları flood maddeleri haline getirerek kendi görüşlerimi sizlerle paylaşmak istedim. Keyifli okumalar dilerim.\n\n1/8",entity_set:$R[226]={__ref:"client:Tm90ZVR3ZWV0OjE5OTcyODA3MzM0MzAxNzM2OTY=:entity_set"},id:"Tm90ZVR3ZWV0OjE5OTcyODA3MzM0MzAxNzM2OTY="},"client:Tm90ZVR3ZWV0OjE5OTcyODA3MzM0MzAxNzM2OTY=:entity_set":$R[227]={__id:"client:Tm90ZVR3ZWV0OjE5OTcyODA3MzM0MzAxNzM2OTY=:entity_set",__typename:"EntitySet",hashtags:$R[228]={__refs:$R[229]=[]},symbols:$R[230]={__refs:$R[231]=["client:Tm90ZVR3ZWV0OjE5OTcyODA3MzM0MzAxNzM2OTY=:entity_set:symbols:0"]},smarttags:null,urls:$R[232]={__refs:$R[233]=[]},user_mentions:$R[