e_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[319]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM3OTE3OTY5NjUzNjM3MTIx"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDM3OTE3OTY5NjUzNjM3MTIx:$R[320]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM3OTE3OTY5NjUzNjM3MTIx",__typename:"NoteTweetResults",result:$R[321]={__ref:"Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM3OTE3OTY5NjUzNjM3MTIx"},"Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE=":$R[322]={__id:"Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE=",__typename:"NoteTweet",text:"Arkadaşlar,\n\nÖğrenci arkadaşlarımıza yardım edelim, 10-12 kişiye 100 dolar dağıtalım diyorum - haliyle kanıt olarak transkript istiyorum. @bit_osfer sağ olsun, tek tek uğraşıyor. Buna rağmen birileri çıkıp showmen diyor, yardım yapacan show yapma diyor. Yalancısın, dağıtmıyorsun diyor. Kimse rencide olmasın diye, “şu kişilere şunları gönderdim” demiyorum diye iftira atılıp üstüne terbiyesizce şeyler söyleniyor.\n\nSineye çekiyorum, gidip bu sefer iyilik olsun - beni takip eden ve yorumunu esirgemeyen arkadaşlara bir nebze faydam olsun diye hediye dağıtımı şeklinde herkesi kapsayan bir uygulama düzenliyorum. Bu sefer, bir kişinin 30 hesap ile katılım sağladığını görüyoruz, tespit ediyoruz. Bunun gibi aksiyonları yapan birçok kişi olduğunu görüyoruz. Bu kişinin/kişilerin bu yöntemle ayda 5-10K USD arası para kazandığını tespit ediyoruz.\n\nAyıptır, ihtiyacı ve hakkı olanın hakkına gasptır bunlar. Sizin yüzünüzden artık iyilik dahi yaparken bin tane şey düşünmek zorunda kalıp mesai harcıyoruz. Bir nevi buradaki profilin varlığı sizin sayenizde diye karınca kararınca kazandıklarımızı size geri dağıtmaya çalışıyoruz ama bu şekilde ilerlenirse bir daha yaralı parmağa dahi işemeyeceğim. Ayıptır ya.\n\nSon 2 ayda ramazan vesilesiyle bu platformda koşulsuz-şartsız 2000 USDT civarında yardımda, hediye dağıtımında bulundum. Allah kabul etsin ama çakal çukala da gittiyse bu paralar, helal olmasın. \nAnlayana bu sözlerin ne kadar ağır olduğunu izah etmeme gerek yok. Anlamayan da ilahi adalet ile cezasını er ya da geç bulacaktır.",entity_set:$R[323]={__ref:"client:Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE="},"client:Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE=:entity_set":$R[324]={__id:"client:Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE=:entity_set",__typename:"EntitySet",hashtags:$R[325]={__refs:$R[326]=[]},symbols:$R[327]={__refs:$R[328]=[]},smarttags:null,urls:$R[329]={__refs:$R[330]=[]},user_mentions:$R[331]={__refs:$R[332]=["client:Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE=:entity_set:user_mentions:0":$R[333]={__id:"client:Tm90ZVR3ZWV0OjIwMzc5MTc5Njk2NTM2MzcxMjE=:entity_set:user_mentions:0",__typename:"ApiMentionEntity",indices:$R[334]=[138,148],is_unmentioned:null,screen_name:"bit_osfer"},"client:VHdlZXQ6MjAzNzkxNzk2OTg0NjU3OTIyMw==:grok_translated_post_with_availability":$R[335]={__id:"client:VHdlZXQ6MjAzNzkxNzk2OTg0NjU3OTIyMw==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjAzNzkxNzk2OTg0NjU3OTIyMw==:legacy":$R[336]={__id:"client:VHdlZXQ6MjAzNzkxNzk2OTg0NjU3OTIyMw==:legacy",__typename:"LegacyTweet",possibly_sensitive:!1,retweeted_status_results:null},"client:VHdlZXQ6MjAzNzkxNzk2OTg0NjU3OTIyMw==:edit_control":$R[337]={__id:"client:VHdlZXQ6MjAzNzkxNzk2OTg0NjU3OTIyMw==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[338]=["2037917969846579223"]},"urt:server:TimelineTimelineEntry:conversationthread-2037972703060336950":$R[339]={__id:"urt:server:TimelineTimelineEntry:conversationthread-2037972703060336950",__typename:"TimelineTimelineEntry",entry_id:"conversationthread-2037972703060336950",sort_index:"2089459210893918188",content:$R[340]={__ref:"client:urt:server:TimelineTimelineEntry:conversationthread-2037972703060336950:content"}},"client:urt:server:TimelineTimelineEntry:conversationthread-20379