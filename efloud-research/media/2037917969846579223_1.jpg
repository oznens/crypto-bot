$R[404]={__id:"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:views",__typename:"ViewCountInfo",count:"2211"},"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:mention_entities:0":$R[405]={__id:"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:mention_entities:0",__typename:"ApiMentionEntity",id_str:"1063939505827323904",indices:$R[406]=[0,7],is_unmentioned:null,screen_name:"Efloud"},"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:mention_entities:1":$R[407]={__id:"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:mention_entities:1",__typename:"ApiMentionEntity",id_str:"1113773604909518848",indices:$R[408]=[8,18],is_unmentioned:null,screen_name:"bit_osfer"},"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:note_tweet":$R[409]={__id:"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[410]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM3OTcyNzAyOTgwNjMyNTc2"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDM3OTcyNzAyOTgwNjMyNTc2:$R[411]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM3OTcyNzAyOTgwNjMyNTc2",__typename:"NoteTweetResults",result:$R[412]={__ref:"Tm90ZVR3ZWV0OjIwMzc5NzI3MDI5ODA2MzI1NzY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM3OTcyNzAyOTgwNjMyNTc2"},"Tm90ZVR3ZWV0OjIwMzc5NzI3MDI5ODA2MzI1NzY=":$R[413]={__id:"Tm90ZVR3ZWV0OjIwMzc5NzI3MDI5ODA2MzI1NzY=",__typename:"NoteTweet",text:"Bu platformda haset ve kötü niyetli insan sayısı o kadar fazla ki… \n\nBurası insanların kendi karmasını, ilahi adalet terazisini kaydırdığı bir mecra oldu/oluyor. \n\nAma emin ol bu tip şeylere laf edenlerin kendi hayatları dışardan öyle göstermeseler de o kadar acınası gidiyor ki, kendileri bile farkında değil. \n\n“Ben de burdayım” demenin akıllıca bir yolunu bulamayınca, böyle şeyler yazıp insanları ragebait’e getirip, sonunda da dikkat çekip dopamin ihtiyaçlarını gideriyorlar. \n\nBelki sosyal medya öncesi de böyleydi ama ben bu kadar kötü niyetli, haset insan olduğunu burada öğrendim. \n\nAma yüzleşirler mutlaka, burunları boktan kurtulmaz bu yaklaşımda insanların. Ömürleri boyu birileri onları kaale alsın diye bu hayatı çürütüp giderler.",entity_set:$R[414]={__ref:"client:Tm90ZVR3ZWV0OjIwMzc5NzI3MDI5ODA2MzI1NzY=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMzc5NzI3MDI5ODA2MzI1NzY="},"client:Tm90ZVR3ZWV0OjIwMzc5NzI3MDI5ODA2MzI1NzY=:entity_set":$R[415]={__id:"client:Tm90ZVR3ZWV0OjIwMzc5NzI3MDI5ODA2MzI1NzY=:entity_set",__typename:"EntitySet",hashtags:$R[416]={__refs:$R[417]=[]},symbols:$R[418]={__refs:$R[419]=[]},smarttags:null,urls:$R[420]={__refs:$R[421]=[]},user_mentions:$R[422]={__refs:$R[423]=[]}},"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:grok_translated_post_with_availability":$R[424]={__id:"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:legacy":$R[425]={__id:"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:legacy",__typename:"LegacyTweet",possibly_sensitive:null,retweeted_status_results:null},"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:edit_control":$R[426]={__id:"client:VHdlZXQ6MjAzNzk3MjcwMzA2MDMzNjk1MA==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[427]=["2037972703060336950"]},"client:urt:server:TimelineTimelineEntry:conversationthread-2037972703060336950:content:metadata":$R[428]={__id:"client:urt:server:TimelineTimelineEntry:conversationthread-2037972703060336950:content:metadata",__typename:"TimelineModuleMetadata",conversation_metadata:$R[429]={__ref:"client:urt:server:TimelineTimelineEntry:conversationthread-2037972703060336950:content:metadata:conversation_metadata"}},"client:urt:server:TimelineTimelineEntry:conversationthread-2037972703060336950:content:metadata:conversation_metadata":$R[430]={__id:"client:urt:server:TimelineTimelineEntry:conversationthread-2037972703060336950:content:metadata:conversation_metadata",__typename:"TimelineModuleConversationMetadata",all_tweet_ids:$R[431]=["2037972703060336950"]},"urt:server:TimelineTimelineEntry:conversationthread-2037919659740008784"