c5NzY2MzEwNjkwODE2"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTk1ODc5NzY2MzEwNjkwODE2:$R[243]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk1ODc5NzY2MzEwNjkwODE2",__typename:"NoteTweetResults",result:$R[244]={__ref:"Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk1ODc5NzY2MzEwNjkwODE2"},"Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY=":$R[245]={__id:"Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY=",__typename:"NoteTweet",text:"$BTC | LTF - Pozisyon Güncellemesi\n\nMerhabalar,\n\nGeçtiğimiz analizden olan önemli notları grafik üzerinde görebilirsiniz. Söylemlerime binaen aldığım aksiyonlar da yine grafik üzerinde mevcut.\n\nFiyat, WO/MO yani kurumsal seviyelerden haftalık - aylık açılış kesişimine ve düşüş öncesi konsolidasyon yaptığı yere geldi. Bu sebeple, geçtiğimiz analizden kalan pozisyonum ve $87700 ile $83813'den ek aldığım işlemleri kapatmış bulunuyorum.\n\nBir önceki analiz daha geniş bir perspektif seviye vurguları içerdiği için yeniden kendimi tekrar etmemek adına oralara vurgu yapmayacağım, alıntıladığım analizden kontrol edebilirsiniz.\n\nGüncel kondisyonlarda fiyatın PWO'u kaybetmesini görmek istemem, hatta mümkünse $88500 altına sarkmadan bu bölgeleri kırarak ilerlemesi bir süre rahatlayacağımıza işaret olabilir.\n\nNot: $AAVE güncellemesi yapamadım ancak onda da kalan pozisyonumu büyük ölçüde kapatmış bulunuyorum (entry $147). İncelemek isteyenler için analiz: https://t.co/Hr6cenSlTO\n\nHerkese bol kazançlar dilerim, kolay gelsin.",entity_set:$R[246]={__ref:"client:Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY=:entity_set"},id:"Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY="},"client:Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY=:entity_set":$R[247]={__id:"client:Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY=:entity_set",__typename:"EntitySet",hashtags:$R[248]={__refs:$R[249]=[]},symbols:$R[250]={__refs:$R[251]=["client:Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjE5OTU4Nzk3NjYzMTA2OTA4MTY=:entity_set:symbols:1"]},smarttags:null,urls:$R[252]={__refs: