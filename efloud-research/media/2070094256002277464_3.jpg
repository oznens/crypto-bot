aybederse $1660 bölgesinden reaksiyon alabileceğine dair vurgularımı grafik üzerinden görebilirsiniz.\n\nBuna binaen kurguladığım alım pozisyonunda az https://t.co/1uZDtpc7WC",hashtag_entities:$R[158]={__refs:$R[159]=[]},cashtag_entities:$R[160]={__refs:$R[161]=["client:VHdlZXQ6MjA2ODI1NTMxMzY0MDE2MTQxNw==:details:cashtag_entities:0"]},smarttags:$R[162]={__refs:$R[163]=[]},created_at_ms:1781945467000,self_thread_metadata:null},"client:VHdlZXQ6MjA2ODI1NTMxMzY0MDE2MTQxNw==:details:cashtag_entities:0":$R[164]={__id:"client:VHdlZXQ6MjA2ODI1NTMxMzY0MDE2MTQxNw==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[165]=[0,4],tag:$R[166]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},U21hcnRUYWc6RVRI:$R[167]={__id:"U21hcnRUYWc6RVRI",__typename:"SmartTag",info:$R[168]={__ref:"client:U21hcnRUYWc6RVRI:info"},id:"U21hcnRUYWc6RVRI"},"client:U21hcnRUYWc6RVRI:info":$R[169]={__id:"client:U21hcnRUYWc6RVRI:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[170]={__ref:"client:U21hcnRUYWc6RVRI:info:info"}},"client:U21hcnRUYWc6RVRI:info:info":$R[171]={__id:"client:U21hcnRUYWc6RVRI:info:info",__typename:"FinanceSmartTagInfo",ticker:"ETH"},"client:VHdlZXQ6MjA2ODI1NTMxMzY0MDE2MTQxNw==:note_tweet":$R[172]={__id:"client:VHdlZXQ6MjA2ODI1NTMxMzY0MDE2MTQxNw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[173]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY4MjU1MzEzNDcyMzg5MTIw"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDY4MjU1MzEzNDcyMzg5MTIw:$R[174]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY4MjU1MzEzNDcyMzg5MTIw",__typename:"NoteTweetResults",result:$R[175]={__ref:"Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY4MjU1MzEzNDcyMzg5MTIw"},"Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=":$R[176]={__id:"Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=",__typename:"NoteTweet",text:"$ETH | Rapor Güncellemesi - Potansiyel Seviyeler/Aksiyonlar\n\nMerhabalar,\n\nRaporlarımda nerenin güncel direnç olabileceği ve nereyi kaybederse $1660 bölgesinden reaksiyon alabileceğine dair vurgularımı grafik üzerinden görebilirsiniz.\n\nBuna binaen kurguladığım alım pozisyonunda az olsa da emirlerimin bir kısmı dolmuş.\n\nŞu an kaybettiği eski range bölgesi (RL) ve kurumsal seviye olan WO (weekly open / haftalık açılış) kısmına gelindiği ve rapor takibi yapanlar olduğunu bildiğim için dolan emirlerimi sattığımı bildirmek isterim.\n\nDüşüşün derinleşmesi kondisyonunda ($BTC'nin de $61.500 civarlarına gerilemesiyle) #ETH'da olan potansiyel seviyelerimi alıntıladığım post'taki rapordan takip edebilirsiniz.\n\nGelecek hafta bir aksilik olmazsa rutin analizler dışında  bir adet makale ve bir adet MPA videosu ile karşınızda olmaya çalışacağım.\n\nHerkese güzel bir hafta sonu, trade'lerinde başarılar dilerim 🤝",entity_set:$R[177]={__ref:"client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA="},"client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set":$R[178]={__id:"client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set",__typename:"EntitySet",hashtags:$R[179]={__refs:$R[180]=["client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set:hashtags:0"]},symbols:$R[181]={__refs:$R[182]=["client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set:symbols:0"]},smarttags:$R[183]={__refs:$R[184]=[]},urls:$R[185]={__refs:$R[186]=[]},user_mentions:$R[187]={__refs:$R[188]=[]}},"client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set:hashtags:0":$R[189]={__id:"client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[190]=[616,620],text:"ETH"},"client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set:symbols:0":$R[191]={__id:"client:Tm90ZVR3ZWV0OjIwNjgyNTUzMTM0NzIzODkxMjA=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[192]=[0,4],tag:$R[193]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},"client:VHdlZXQ6MjA2ODI1NTMxMzY0MDE2MTQxNw==:grok_translated_post_with_availability":$R[194]={__id:"client:VHdlZXQ6MjA2ODI1NTMxMzY0MDE2MTQxNw==:grok_translated_post_with_availabi