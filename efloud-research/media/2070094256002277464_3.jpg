:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:details:conversation_control":$R[210]={__id:"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[211]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:details:cashtag_entities:0":$R[212]={__id:"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[213]=[0,4],tag:$R[214]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},U21hcnRUYWc6QlRD:$R[215]={__id:"U21hcnRUYWc6QlRD",__typename:"SmartTag",info:$R[216]={__ref:"client:U21hcnRUYWc6QlRD:info"},id:"U21hcnRUYWc6QlRD"},"client:U21hcnRUYWc6QlRD:info":$R[217]={__id:"client:U21hcnRUYWc6QlRD:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[218]={__ref:"client:U21hcnRUYWc6QlRD:info:info"}},"client:U21hcnRUYWc6QlRD:info:info":$R[219]={__id:"client:U21hcnRUYWc6QlRD:info:info",__typename:"FinanceSmartTagInfo",ticker:"BTC"},"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:details:cashtag_entities:1":$R[220]={__id:"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:details:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[221]=[11,15],tag:$R[222]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:views":$R[223]={__id:"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:views",__typename:"ViewCountInfo",count:"112793"},"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:note_tweet":$R[224]={__id:"client:VHdlZXQ6MjA3MDA5NDI1NjAwMjI3NzQ2NA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[225]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcwMDk0MjU1NzU4OTA5NDQx"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDcwMDk0MjU1NzU4OTA5NDQx:$R[226]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcwMDk0MjU1NzU4OTA5NDQx",__typename:"NoteTweetResults",result:$R[227]={__ref:"Tm90ZVR3ZWV0OjIwNzAwOTQyNTU3NTg5MDk0NDE="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcwMDk0MjU1NzU4OTA5NDQx"},"Tm90ZVR3ZWV0OjIwNzAwOTQyNTU3NTg5MDk0NDE=":$R[228]={__id:"Tm90ZVR3ZWV0OjIwNzAwOTQyNTU3NTg5MDk0NDE=",__typename:"NoteTweet",text:"$BTC & $ETH | Rapor Güncellemesi\n\nMerhabalar,\n\n1 haftalık bir seyahat sürecim olacak. Bu süre zarfında çok güncelleme paylaşamayabilirim. Bu sebeple, güncel duruma kısa bir değinme yapıp takip eden herkesin kârlı kalmasını sağlamaya çalışacağım 🤝\n\nGrafik üzerinde göreceğiniz notlardan da anlayacağınız üzere #BTC'de yeşil kutulu bölge, #ETH'da da $1570 bölgesi önem arz ediyordu.\n\n$BTC'de HTF seviyelerde bu bölgenin kaybını görmek istemem. $ETH'da ise $1570'in altına sarkmasını istemem.\n\nKendi adıma $BTC'de erken pozisyon aldığım ve dediğim gibi ilerleyen süreçte çok ilgilenememe durumum olduğu için minimal bir kâr ile işlemimi sonlandırdım. Yeşil kutu içini alarmladım. Confirmation sonrası yeni pozisyon düşüneceğim.\n\n$ETH analizim nispeten daha iyi bir noktadan girişli olduğu için onu muhafaza etmeye çalışacağım, stop->entry şeklinde ilerliyorum. An itibariyle supply (arz) bölgesine ve imbalance'a geldiğimiz için satış geldi. Muhtemelen ilk fazda yeşil kutunun ($1620'ler), reaksiyon yetersiz kalırsa da $1585'lerin retest'ini göreceğiz.\n\nTüm seviyeler vs. 18 Haziran'da yayınladığımız raporda zikredildiği için ekstra olarak \"neden oralara geldi - ne oldu\" gibi konulardan ziyade bundan sonrasında ne olursa yapacaklarım kısmına değinmeye çalıştım.\nRaporu okumak isterseniz: https://t.co/2dnhTlYGhN\n\nHTF'de hâlâ bearish kondisyonlarda olduğumuzu unutmadan ilerlemenizi tavsiye ederim.\n\nFaydalı olması temennilerimle, herkese bol kazançlar ve güzel günler dilerim 🤝",entity_set:$R[229]={__ref:"client:Tm90ZVR3ZWV0OjIwNzAwOTQyNTU3NTg5MDk0NDE=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNzAwOTQyNTU3NTg5MDk0NDE="},"client:Tm90ZVR3ZWV0OjIwNzAwOTQyNTU3NTg5MDk0NDE=:entity_set":$R[230]={__id:"client:Tm90ZVR3ZWV0OjIwNzAwOTQyNTU3NTg5MDk0NDE=:entity_set",__typename:"EntitySet",hashtags:$R[231]={__refs:$R[232]=["client:Tm90ZVR3ZWV0OjIwNzAwOTQyNTU3NTg5MDk0NDE=:entity_set:hashtags:0","c