l},"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:details:cashtag_entities:1":$R[188]={__id:"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:details:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[189]=[37,43],tag:$R[190]={__ref:"U21hcnRUYWc6QlRDLkQ="},text:"BTC.D"},"U21hcnRUYWc6QlRDLkQ=":$R[191]={__id:"U21hcnRUYWc6QlRDLkQ=",__typename:"SmartTag",info:$R[192]={__ref:"client:U21hcnRUYWc6QlRDLkQ=:info"},id:"U21hcnRUYWc6QlRDLkQ="},"client:U21hcnRUYWc6QlRDLkQ=:info":$R[193]={__id:"client:U21hcnRUYWc6QlRDLkQ=:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:note_tweet":$R[194]={__id:"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[195]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1NjUzNDIxMzI4Nzg5NTA0"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTg1NjUzNDIxMzI4Nzg5NTA0:$R[196]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1NjUzNDIxMzI4Nzg5NTA0",__typename:"NoteTweetResults",result:$R[197]={__ref:"Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1NjUzNDIxMzI4Nzg5NTA0"},"Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=":$R[198]={__id:"Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=",__typename:"NoteTweet",text:"Total Market Cap 1 & 2, $ETHBTC, $BTC.D | Update\n\nMerhabalar,\n\nBaşlıkta ismi geçen 4 paritenin marketin genel akıbetini okumak açısından önemli olduğu kanaatindeyim.\n\nGrafiklerimin üzerindeki tüm notlar geçmiş analizimde vurgu yaptığım bölgelerin notlarıdır.\n\nGeçtiğimiz analizde tüm önemsediğim bölgeleri kısaca yazmıştım, bu sefer yine önemsediğim bölgeler ve kazanımı/kaybı sonrası gelebilecek potansiyel direnç/destek bölgelerine de vurgu yapacağım. \n\nDilerim marketi okumanız açısından size ek bir fayda sağlar.\n\nTotal Market Cap\n\n$3.95 T bölgesindeki direnç alanı 2 defa çalıştı ve kâr realizasyonu veya terste kalan pozisyonlar için uyarı niteliğinde paylaşımlar yapıldı.\n\nGüncel destek bölgesi ara bir destek kısmı olan $3.36 T olarak gözüme çarpıyor.\nBu bölgenin destek görevini yerine getirememesi durumunda ise maalesef $3.11 bölgesinde yer alan RL olarak yazılı bölge destek görevi üstlenebilir.\n\nGüncel direnç bölgemiz RH yazan $3.63 T bölgesidir.\n\nSideways (yatay hareket) durumundan ötürü karışık bir fiyat aksiyonu gözlemlemiş olsak da $3.74 T bölgesinin kazanımının da markete pozitif etkisi olacağı kanaatindeyim.\n\nGünü yeşil kutunun üzerinde kapatması bullish fiyat aksiyonun genel akıbeti açısından faydalı olacaktır.\n\nTotal Market Cap 2\n\nDaha önce eldeki altcoin’lerin nerede realize edilmesi gerektiğine dair bir vurgu yapmıştım, grafik üzerindeki nottan gözlemleyebilirsiniz.\n\nGüncel direnç bölgesi kaybettiği kırmızı kutu ($1.45 T) olarak göze çarpıyor.\n\n$1.48 T seviyesinin kazanımı gerçekleşmeden tablo negatif gözüküyor.\n\nGüncel desteği grafik üzerindeki notta da belirtildiği gibi $1.30 T civarlarıdır.\n\nBu bölgenin efektif olmaması ve satış baskının devam etmesi durumunda ise maalesef öngörebildiğim destek $1.17 T civarlarıdır.\n\n#ETHBTC\n\n0.036 bölgesini direnç olarak belirlemiştik. Fiyat 0.037’den ret alarak maalesef aşağı yönlü hareketini başlattı.\n\nYO (Yearly Open / Yıllık Açılış) yazan yer kazanılmadığı müddetçe ETHBTC adına pozitif konuşmak mantıksız olacaktır.\nYO kazanımı gerçekleşirse bir diğer direnç olan 0.0382 gündeme gelecektir.\n\nUzunca süredir vurguladığım gibi, asıl altcoin rallisi vb senaryoların gündeme gelebilmesi için grafikte gördüğünüz kırmızı kutu/diyagonal trend çizgisi bölgelerinin geçilmesi gerekiyor, bu da #BTC.D ’de %57 seviyelerinin kaybı anlamına geliyor.\n\nGüncel destek bölgesi hakkında yorumumu da yine grafik üzerindeki notta görebilirsiniz.\n\n$BTC.D\n\n%59.2 bölgesinin destek görevi üstlenebileceğinden bahsetmiştik. Fiyat %59.02’den destek buldu.\n\nAn itibariyle %61.7 bölgesine hareketlenmiş gözüküyor. Kırmızı kutunun kazanımı marketin genel akıbeti açısından iyi olmayacaktır.\n\nO bölgeyi kazansa dahi ivedilikle deviasyon hareketi olarak sonlanması lazım ki pozitif senaryoları dile getirebilelim.\nGüncel desteği %60.1’dir.\n\n%59.2 bölgesinin kaybı ile %58 bölgesini gündeme alabiliriz.",entity_set:$R[199]={__ref:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set"},id:"Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ="},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set":$R[200]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set",__typename:"EntitySet",hashtags:$R[201]={__refs:$R[202]=["client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:1"]},symbols:$R[203]={__refs:$R[204]=["client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:2"]},smarttags:null,urls:$R[205]={__refs:$R[206]=[]},user_mentions:$R[207]={__refs:$R[208]=[]}},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:0":$R[209]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[210]=[1760,1767],text:"ETHBTC"},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:1":$R[211]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:1",__typename:"ApiTagEntity",indices:$R[212]=[2270,2274],text:"BTC"},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:0":$R[213]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[214]=[24,31],tag:$R[215]={__ref:"U21hcnRUYWc6RVRIQlRD"},text:"ETHBTC"},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:1":$R[216]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:1",__typename:"ApiTagEntity",indices:$R[217]=[33,39],tag:$R[218]={__ref:"U21hcnRUYWc6QlRDLkQ="},text:"BTC.D"},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbol