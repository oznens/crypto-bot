yNzMyMzkwNA=="}},"client:VHdlZXQ6MjA2Mjc4ODg4MDk4MjU3MzIzMg==:details:cashtag_entities:0":$R[226]={__id:"client:VHdlZXQ6MjA2Mjc4ODg4MDk4MjU3MzIzMg==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[227]=[0,4],tag:$R[228]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},"client:VHdlZXQ6MjA2Mjc4ODg4MDk4MjU3MzIzMg==:views":$R[229]={__id:"client:VHdlZXQ6MjA2Mjc4ODg4MDk4MjU3MzIzMg==:views",__typename:"ViewCountInfo",count:"59710"},"client:VHdlZXQ6MjA2Mjc4ODg4MDk4MjU3MzIzMg==:note_tweet":$R[230]={__id:"client:VHdlZXQ6MjA2Mjc4ODg4MDk4MjU3MzIzMg==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[231]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYyNzg4ODgwNzE4MjQ5OTg0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDYyNzg4ODgwNzE4MjQ5OTg0:$R[232]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYyNzg4ODgwNzE4MjQ5OTg0",__typename:"NoteTweetResults",result:$R[233]={__ref:"Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYyNzg4ODgwNzE4MjQ5OTg0"},"Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=":$R[234]={__id:"Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=",__typename:"NoteTweet",text:"$BTC | Satış Bildirisi - Final\n\nMerhabalar,\n\nDüşüşün devamlılığının gelmesini olası görerek son kalan %25'lik satış paydamı tutmaya karar verdim. An itibarıyla kalan payı da buralardan kapatıyorum. Çok ufak bir pay açık bırakacağım ancak bundan sonra güncellemesini geçmeyeceğim.\n\nBenim için güzel bir süreç oldu. Spot'ları doğru yerden satıp short'layabilmiş olmak genellikle kripto markette en verimli hareket kombinasyonu olmuştur. Gönül isterdi ki market eskisi gibi ralli modunu açsın.. Lakin şimdilik böyle bir olgunlaşma söz konusu değil.\n\nSon kârımı buralardan almamın sebebi:\nDün akşam yayınlanan raporda da belirttiğim üzere fiyatın ciddi bir boşluk bölgesine girmeden evvel son desteklerinden birine gelmiş olması ve eski bir range bölgemin range low kısmına tekabül etmesi.\n\nBuralarda tutunamazsa zaten ilk aşamada $55.000 civarlarına yolculuğun maalesef başlayacağını düşünüyorum.\n\nHâlâ uzun vadeli long için yeterli altyapının oluştuğunu düşünmüyorum. Bu civarlarda long için dönüş emaresi (confirmation yapılarını) gözlemlemeye çalışacağım. Bunu gözlemlersem, işlemlerim kısa-orta vadeli olacaktır.\n\nConfirmation nedir?\n🔗 https://t.co/Jg94RShF0F\n\nHTF perspektifi ve LTF direnç seviyeleri neler olabilir diye merak edenler için dün akşam yayınlanan raporu okuyabilirler: https://t.co/IYE0gp4YoO\n\nAksiyonlarımı en başından beri paylaştığım için finalize etmek de bugüne nasip olduğundan bu post'u hazırladım. İşlemlerden yararlanamamış olsanız bile güzel bir öğreti olduğunu düşünüyorum. Bu yüzden vaktiniz olursa alıntılı postlardan geriye sararak ilerlemenizi - incelemenizi tavsiye ederim.\n\nHerkese hayırlı cumalar, şimdiden güzel bir hafta sonu ve bol kazançlar diliyorum 🤝",entity_set:$R[235]={__ref:"client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ="},"client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set":$R[236]={__id:"client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set",__typename:"EntitySet",hashtags:$R[237]={__refs:$R[238]=[]},symbols:$R[239]={__refs:$R[240]=["client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set:symbols:0"]},smarttags:$R[241]={__refs:$R[242]=[]},urls:$R[243]={__refs:$R[244]=["client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set:urls:0","client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set:urls:1"]},user_mentions:$R[245]={__refs:$R[246]=[]}},"client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set:symbols:0":$R[247]={__id:"client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[248]=[0,4],tag:$R[249]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},"client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set:urls:0":$R[250]={__id:"client:Tm90ZVR3ZWV0OjIwNjI3ODg4ODA3MTgyNDk5ODQ=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"youtu.be/Z8721SXmRTU",expanded_url:"https://youtu.be/Z8721SXmRTU",ind