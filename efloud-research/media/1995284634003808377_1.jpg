count:"39155"},"client:VHdlZXQ6MTk5NTI4NDYzNDAwMzgwODM3Nw==:mention_entities:0":$R[298]={__id:"client:VHdlZXQ6MTk5NTI4NDYzNDAwMzgwODM3Nw==:mention_entities:0",__typename:"ApiMentionEntity",id_str:"89078830",indices:$R[299]=[0,14],is_unmentioned:null,screen_name:"mavigozluudev"},"client:VHdlZXQ6MTk5NTI4NDYzNDAwMzgwODM3Nw==:mention_entities:1":$R[300]={__id:"client:VHdlZXQ6MTk5NTI4NDYzNDAwMzgwODM3Nw==:mention_entities:1",__typename:"ApiMentionEntity",id_str:"1531299944878985217",indices:$R[301]=[15,30],is_unmentioned:null,screen_name:"psikolojik_bey"},"client:VHdlZXQ6MTk5NTI4NDYzNDAwMzgwODM3Nw==:url_entities:0":$R[302]={__id:"client:VHdlZXQ6MTk5NTI4NDYzNDAwMzgwODM3Nw==:url_entities:0",__typename:"UrlsEntity",display_url:"x.com/Efloud/status/…",expanded_url:"https://x.com/Efloud/status/1991058465028976763?s=20",indices:$R[303]=[79,102],url:"https://t.co/qlOlpI0hQH"},"client:VHdlZXQ6MTk5NTI4NDYzNDAwMzgwODM3Nw==:note_tweet":$R[304]={__id:"client:VHdlZXQ6MTk5NTI4NDYzNDAwMzgwODM3Nw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[305]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk1Mjg0NjMzNzczMDE5MTM3"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTk1Mjg0NjMzNzczMDE5MTM3:$R[306]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk1Mjg0NjMzNzczMDE5MTM3",__typename:"NoteTweetResults",result:$R[307]={__ref:"Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk1Mjg0NjMzNzczMDE5MTM3"},"Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=":$R[308]={__id:"Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=",__typename:"NoteTweet",text:"$ZEN\n\nTabi. Öncelikle son analizi hatırlatayım: https://t.co/AiC4xHk7U1\n\nSon analizden olan notları da grafik üzerinden görebilirsiniz.\n\nDikkat ettiysen(iz) destek bölgesinde alım düşünenlere confirmation'ı önemsemelerini önerirken, direnç bölgesini söylerken böyle bir emareden bahsetmiyorum. \n\nNeden? Çünkü market bearish. \nAkış yönü zaten aşağı doğru. Dirençlerde direkt satış, desteklerde confirmation ile alım düşünülebilir bu durumda.\n\nBuna binaen short yönlü işlem aldım, $13.1'de kısmi kâr aldım. Pozisyonun kalanı devam ediyor.\n\n$13.1'de herhangi bir LTF confirmation oluşmadığı için alım yönlü aksiyon gerçekleştirmedim.\n\nGrafikte EQ bölgesine doğru fiyatın düşme ihtimali mevcut. Bu tip bir durumda grafik üzerinde çizimini yaptığım yapı oluşursa pozisyonumu büyük ölçüde kapatır ve long için kurgu oluştururum. Ancak bir emare görmezsek var olan işlemimi devam ettirmek isterim.\n\nPozitif bir emare görülürse $11.4 bölgesi takip edilmeli, direnç olarak çalışabilir - long yönlü işlem alınırsa o bölgeden kısmen veya tamamen kâr realize edilebilir.\n\nEQ bölgesi de destek görevi üstlenmezse $8.2 civarları bir diğer destek olarak bakılabilecek alan olarak gözüme çarpıyor.\n\nUmarım #ZEN ile ilgili tüm detayları ve markete nasıl baktığımı, buna binaen nasıl aksiyon aldığımı anlatabilmişimdir.\n\nKolay gelsin.",entity_set:$R[309]={__ref:"client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set"},id:"Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc="},"client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set":$R[310]={__id:"client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set",__typename:"EntitySet",hashtags:$R[311]={__refs:$R[312]=["client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set:hashtags:0"]},symbols:$R[313]={__refs:$R[314]=["client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set:symbols:0"]},smarttags:null,urls:$R[315]={__refs:$R[316]=["client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set:urls:0"]},user_mentions:$R[317]={__refs:$R[318]=[]}},"client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set:hashtags:0":$R[319]={__id:"client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[320]=[1190,1194],text:"ZEN"},"client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set:symbols:0":$R[321]={__id:"client:Tm90ZVR3ZWV0OjE5OTUyODQ2MzM3NzMwMTkxMzc=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[322]=[0,4],tag:$R[323]={__ref:"U21hcnRUYWc6WkVO