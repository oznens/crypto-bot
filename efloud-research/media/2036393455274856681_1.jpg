=:details:conversation_control":$R[193]={__id:"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[194]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:details:hashtag_entities:0":$R[195]={__id:"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:details:hashtag_entities:0",__typename:"ApiTagEntity",indices:$R[196]=[6,13],text:"XAUUSD"},"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:details:cashtag_entities:0":$R[197]={__id:"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[198]=[0,5],tag:$R[199]={__ref:"U21hcnRUYWc6R09MRA=="},text:"GOLD"},"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:views":$R[200]={__id:"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:views",__typename:"ViewCountInfo",count:"120702"},"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:note_tweet":$R[201]={__id:"client:VHdlZXQ6MjAzNjM5MzQ1NTI3NDg1NjY4MQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[202]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM2MzkzNDU0OTg5NjU2MDY0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDM2MzkzNDU0OTg5NjU2MDY0:$R[203]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM2MzkzNDU0OTg5NjU2MDY0",__typename:"NoteTweetResults",result:$R[204]={__ref:"Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDM2MzkzNDU0OTg5NjU2MDY0"},"Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=":$R[205]={__id:"Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=",__typename:"NoteTweet",text:"$GOLD #XAUUSD | Pozisyon Güncellemesi & Yeni Düşünceler\n\nMerhabalar,\nÇok fazla gümüş ve altına dair sorular geldiği için genel bir cevap vermek istedim.\nÖncelikle, arama kısmına \"$GOLD (from:Efloud)\" girdisini tırnak işaretleri olmadan yazarak verdiğim tüm cevaplara, aldığım tüm aksiyonlara erişebileceğinizi hatırlatmış olayım.\n\nYakın Geçmiş:\n$4930 alım denemem stop ile sonuçlandı, -1R.\n\nArdından bir diğer önemsediğim bölge olan $4320'yi belirtmiştim. O bölgeden %4,1'lik bir yükseliş gerçekleşti. Anlık uyarı olarak direnç bölgesinden bahsederek pozisyonumun %50'sini realize ettim.\n\nYeni Düşünceler:\nAlttaki yeşil kutulu bölge korunduğu müddetçe altına bakış açım negatif değildir.\nÜstteki yeşil kutulu bölgenin direnç alanı olduğunu düşünüyorum. Bu bölgenin kazanımı ise yükselişin devamlılığını sağlayacaktır diye düşünüyorum.\nBöyle bir durumda, $4700 ve $4850 gibi karşılaşabileceği yeni dirençlerde vereceği reaksiyonları izleyeceğim.\n\n$SILVER tarafında aktif olarak fazla trade yapmadığımı, zamanında aldığım bir miktar ürünü muhafaza ettiğimi iletmiştim, hatırlatmış olayım. Yine de merak edenler için takip ettiğim grafiği aşağıya bırakıyorum.\n\n#XAGUSD: https://t.co/eu1ASUlCni\n\nYeşil kutulu bölgede gözlemleyeceğim micro-LTF confirmation'lar ile kısa vadeli bir işlem düşünebilirim.\n\nHerkese güzel haftalar, bol kazançlar.",entity_set:$R[206]={__ref:"client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ="},"client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set":$R[207]={__id:"client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set",__typename:"EntitySet",hashtags:$R[208]={__refs:$R[209]=["client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set:hashtags:1"]},symbols:$R[210]={__refs:$R[211]=["client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set:symbols:1"]},smarttags:null,urls:$R[212]={__refs:$R[213]=["client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set:urls:0"]},user_mentions:$R[214]={__refs:$R[215]=[]}},"client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set:hashtags:0":$R[216]={__id:"client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5ODk2NTYwNjQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[217]=[6,13],text:"XAUUSD"},"client:Tm90ZVR3ZWV0OjIwMzYzOTM0NTQ5