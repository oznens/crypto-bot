ntities:0":$R[247]={__id:"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:details:hashtag_entities:0",__typename:"ApiTagEntity",indices:$R[248]=[0,6],text:"XU100"},"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:details:cashtag_entities:0":$R[249]={__id:"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[250]=[13,19],tag:$R[251]={__ref:"U21hcnRUYWc6R0FSQU4="},text:"GARAN"},"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:content_disclosure":$R[252]={__id:"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:content_disclosure",__typename:"ContentDisclosure",advertising_disclosure:$R[253]={__ref:"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:content_disclosure:advertising_disclosure"},ai_generated_disclosure:null},"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:content_disclosure:advertising_disclosure":$R[254]={__id:"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:content_disclosure:advertising_disclosure",__typename:"AdvertisingDisclosure",is_paid_promotion:!0},"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:views":$R[255]={__id:"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:views",__typename:"ViewCountInfo",count:"106263"},"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:note_tweet":$R[256]={__id:"client:VHdlZXQ6MjA2MjA5NTUzMDYxNjg2NDk0MA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[257]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYyMDk1NTMwMjQzNTM4OTQ0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDYyMDk1NTMwMjQzNTM4OTQ0:$R[258]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYyMDk1NTMwMjQzNTM4OTQ0",__typename:"NoteTweetResults",result:$R[259]={__ref:"Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYyMDk1NTMwMjQzNTM4OTQ0"},"Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=":$R[260]={__id:"Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=",__typename:"NoteTweet",text:"#XU100 & $GARAN | Güncellemeler\n\nMerhabalar,\n\nMutlak Butlan kararı sonrası markette ciddi bir satış baskısı yaşadık. \nBu sebeple, $XU100'de mavi kutudan olan destek fikrim çalışmadı fakat o bölgenin kaybı ile ziyaret etmesini beklediğim Open/Close Actual Gap aralığı işlevselliğini gösterdi ve fiyata destek olabildi.\n\nAn itibarıyla mavi kutulu bölgenin üst taraflarında yer alan 14550 civarı, problem arz edebilecek direnç kısımları olarak gözüme çarpıyor. Geri çekilmelerde ise 13925 bölgesini alarmlamış durumdayım. Vereceği reaksiyonu gözlemlemek isterim.\n\nOpen/Closed Actual Gap bölgesinin kaybı markette ciddi bir sıkıntı başlatabilir. Dikkatli olmakta ve o bölgenin kaybının olup olmayacağını takip etmekte fayda var.\n\n$XU100.USD ise daha tutarlı şekilde ilerledi. Direnç bölgemden bahsetmiştim ve güncel swing low bölgesinin kaybı ile ziyaret edeceği alanları sıralamıştım. $296 bölgesinden reaksiyon bulan fiyatın güncel direnç bölgesi $317 bölgesi olarak gözüme çarpıyor. Kısa vadede ise $303 bölgesinden vereceği reaksiyonu izlemek istiyorum.\n\n#GARAN’da ise destek bölgelerimden biri olan yeşil kutu işlevselliğini sürdürüyor. O bölgenin kaybı yaşanırsa aşağıdaki yeşil kutulu bölge alarmlı konumda. Güncel kısa vadedeki direnci mavi kutulu bölge, güncel kısa vadedeki desteği ise 124 civarı olarak gözüme çarpıyor.\n \nSiz de bu hareketleri benim gibi Midas’ın uygulamasını üzerinden takip etmek isterseniz aşağıdaki link’ten uygulamayı indirebilirsiniz.\n🔗https://t.co/fjCFy1ee15\n\nYakında erişime açılacak olan Atlas’a erken erişim isterseniz\n🌐 https://t.co/1cjJPg6QoM\n\nNot: Burada yer alan yatırım bilgileri, yorumları ve tavsiyeleri yatırım danışmanlığı kapsamında değildir. Yatırım danışmanlığı hizmeti, yetkili kuruluşlar tarafından kişilerin risk ve getiri tercihleri dikkate alınarak kişiye özel sunulmaktadır. Burada yer alan bilgiler ise genel nitelikte olup raporda yer alan kişilerin yorum ve görüşlerini içermektedir. Bu tavsiyeler mali durumunuz ile risk ve getiri tercihlerinize uygun olmayabilir. Bu nedenle, sadece burada yer alan bilgilere dayanılarak yatırım kararı verilmesi beklentilerinize uygun sonuçlar doğurmayabilir.\n\n#işbirliği",entity_set:$R[261]={__ref:"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ="},"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set":$R[262]={__id:"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set",__typename:"EntitySet",hashtags:$R[263]={__refs:$R[264]=["client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:1","client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:2"]},symbols:$R[265]={__refs:$R[266]=["client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:symbols:0"]},smarttags:$R[267]={__refs:$R[268]=[]},urls:$R[269]={__refs:$R[270]=["client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:urls:0","client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:urls:1"]},user_mentions:$R[271]={__refs:$R[272]=[]}},"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:0":$R[273]={__id:"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[274]=[0,6],text:"XU100"},"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:1":$R[275]={__id:"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:1",__typename:"ApiTagEntity",indices:$R[276]=[1055,1061],text:"GARAN"},"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:2":$R[277]={__id:"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:hashtags:2",__typename:"ApiTagEntity",indices:$R[278]=[2152,2162],text:"işbirliği"},"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:symbols:0":$R[279]={__id:"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[280]=[9,15],tag:$R[281]={__ref:"U21hcnRUYWc6R0FSQU4="},text:"GARAN"},"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:urls:0":$R[282]={__id:"client:Tm90ZVR3ZWV0OjIwNjIwOTU1MzAyNDM1Mzg5NDQ=:entity_set:urls:0",__ty