zNzI4NTk4MDU2OTYx"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDIyOTYzNzI4NTk4MDU2OTYx:$R[692]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDIyOTYzNzI4NTk4MDU2OTYx",__typename:"NoteTweetResults",result:$R[693]={__ref:"Tm90ZVR3ZWV0OjIwMjI5NjM3Mjg1OTgwNTY5NjE="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDIyOTYzNzI4NTk4MDU2OTYx"},"Tm90ZVR3ZWV0OjIwMjI5NjM3Mjg1OTgwNTY5NjE=":$R[694]={__id:"Tm90ZVR3ZWV0OjIwMjI5NjM3Mjg1OTgwNTY5NjE=",__typename:"NoteTweet",text:"Hocam eline sağlık teşekkürler. Bist tarafında 2018'den beri aktif olarak yatırım yapar/trade ederim. Fonlarda da aynı şekilde. Yorumların kıymetli❤️\n\nSon birkaç aydır gerçekleşen hareketler fiyatlarla desteklense de uzun sürelerden beri kalmış ucuzluğumuz ve bu imkanlara sahip olan ve ucuz ülke kalmamış olmasına bağlanacağını düşünüyorum temel olarak özellikle. Sermaye sahibi Arjantin dahil olmak üzere yapabileceğini yaptı, dünya üzerinde geriye bizim borsa kaldı. \n\nİç dizaynların değişmesi, bu zamana kadar gelmiş dinozor yatırımcıların güven kaybı ve oyundaki paylarından müsaade etmelerini sağlarlarsa şayet, sermayenin bizim borsaya yerleşmek için uygun ortam yaratacağını düşünüyorum. Seçim ekonomisinin de geleceğini düşünürsek \n\n-Perakende\n-GYO\n-Dayanıklı Tüketim\n-Bankacılık(Sonrasında)\n\nBu sektörlere dikkat etmek lazım. Burada çalışan firmalar zaten çok güçlü hareketler yaptı ancak ara düzeltmeler gitmiş fırsatların tekrar sahiplenilmesine olanak sağlayabilir diye düşünüyorum.\n\nTekrardan teşekkürler kıymetli yorumların için❤️",entity_set:$R[695]={__ref:"client:Tm90ZVR3ZWV0OjIwMjI5NjM3Mjg1OTgwNTY5NjE=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMjI5NjM3Mjg1OTgwNTY5NjE="},"client:Tm90ZVR3ZWV0OjIwMjI5NjM3Mjg1OTgwNTY5NjE=:entity_set":$R[696]={__id:"client:Tm90ZVR3ZWV0OjIwMjI5NjM3Mjg1OTgwNTY5NjE=:entity_set",__typename:"EntitySet",hashtags:$R[697]={__refs:$R[698]=[]},symbols:$R[699]={__refs:$R[700]=[]},smarttags:null,urls:$R[701]={__refs:$R[702]=[]},user_mentions:$R[703]={__refs:$R[704]=[]}},"client:VHdlZXQ6MjAyMjk2MzcyODc1NzUyNjkwNQ==:grok_translated_post_w