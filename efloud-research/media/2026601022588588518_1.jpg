]=["client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:details:cashtag_entities:0"]},smarttags:$R[213]={__refs:$R[214]=[]}},"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:details:conversation_control":$R[215]={__id:"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[216]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:details:hashtag_entities:0":$R[217]={__id:"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:details:hashtag_entities:0",__typename:"ApiTagEntity",indices:$R[218]=[129,133],text:"BTC"},"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:details:cashtag_entities:0":$R[219]={__id:"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[220]=[0,4],tag:$R[221]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:views":$R[222]={__id:"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:views",__typename:"ViewCountInfo",count:"76702"},"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:note_tweet":$R[223]={__id:"client:VHdlZXQ6MjAyNjYwMTAyMjU4ODU4ODUxOA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[224]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI2NjAxMDIyNDI5MjU3NzI4"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDI2NjAxMDIyNDI5MjU3NzI4:$R[225]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI2NjAxMDIyNDI5MjU3NzI4",__typename:"NoteTweetResults",result:$R[226]={__ref:"Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI2NjAxMDIyNDI5MjU3NzI4"},"Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=":$R[227]={__id:"Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=",__typename:"NoteTweet",text:"$BTC | LTF Update\n\nAfter two successful predictions, my trades closed in profit and I no longer hold any short-term positions on #BTC. You can verify this from the notes on the chart or reposts.\n\nWhile the price continues to consolidate within the range, it has found a solid reaction from the OTE zone located in the discount area of the range.\n\nUpon a break above the EQ zone, the problematic area, which is the PWO-WO interval ($68,300–$69,000), will come into play. There is a possibility that it acts as short-term resistance. Unless a decisive breakout of that zone is observed, the price will continue to chop around within this range.\n\nIn the meantime, as I highlighted in previous reports, $BTC.D getting rejected from the red box and declining toward the 58.1% level has prevented altcoins from making a new low. The short-term levels I am currently monitoring are 58.1% and 58.8%.\n\nTomorrow, I will be back with the HTF & LTF analyses of $BTC, $ETH, $ETHBTC, and $BTC.D, which will be published in the research report. \nUntil then, wishing everyone successful trades and great profits 🤝",entity_set:$R[228]={__ref:"client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg="},"client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set":$R[229]={__id:"client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set",__typename:"EntitySet",hashtags:$R[230]={__refs:$R[231]=["client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:hashtags:0"]},symbols:$R[232]={__refs:$R[233]=["client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:symbols:3","client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:symbols:4","client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:symbols:5"]},smarttags:null,urls:$R[234]={__refs:$R[235]=[]},user_mentions:$R[236]={__refs:$R[237]=[]}},"client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:hashtags:0":$R[238]={__id:"client:Tm90ZVR3ZWV0OjIwMjY2MDEwMjI0MjkyNTc3Mjg=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[239]=[129,133],t