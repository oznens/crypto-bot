typename:"SmartTag",info:$R[161]={__ref:"client:U21hcnRUYWc6WFJQ:info"},id:"U21hcnRUYWc6WFJQ"},"client:U21hcnRUYWc6WFJQ:info":$R[162]={__id:"client:U21hcnRUYWc6WFJQ:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[163]={__ref:"client:U21hcnRUYWc6WFJQ:info:info"}},"client:U21hcnRUYWc6WFJQ:info:info":$R[164]={__id:"client:U21hcnRUYWc6WFJQ:info:info",__typename:"FinanceSmartTagInfo",ticker:"XRP"},"client:VHdlZXQ6MTk4ODI4MjgzMDM0NjkzMjU0Ng==:note_tweet":$R[165]={__id:"client:VHdlZXQ6MTk4ODI4MjgzMDM0NjkzMjU0Ng==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[166]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg4MjgyODMwMDgyNzg1Mjgw"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTg4MjgyODMwMDgyNzg1Mjgw:$R[167]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg4MjgyODMwMDgyNzg1Mjgw",__typename:"NoteTweetResults",result:$R[168]={__ref:"Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg4MjgyODMwMDgyNzg1Mjgw"},"Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=":$R[169]={__id:"Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=",__typename:"NoteTweet",text:"$XRP | Update\n\nBüyük satış öncesi \"Daily Imb\" yazan bölgelerin öneminden bahsedip alım potansiyeli arayacağımı söylemiştim.\nBu 2 bölgenin önemi devam ediyor.\n\nÜstteki Daily Imb yazan bölgenin kazanımı sonrası yeni dirençler kırmızı kutulu bölge ($2.75’ler) ve oranın da kazanımı ile kırmızı kesikli çizgi ($2.95’ler) olabilir.\n\nAlttaki Daily Imb yazan bölgenin kaybı ise problemli bir sürecin başlangıcı olabilir. Bu tarz bir durumda YO seviyesi tekrar kazanılmadan yükseliş moduna geçmek risk arz edebilir.\n\nKısa vadede desteklerin $2.3 ve $2.2 seviyeleri olabileceğini düşünüyorum. Direkt emir atmaktan ziyade alarm koyup market kondisyonlarını gözlemleyerek işlem düşüncesinde olmakta fayda var.\n\nBu tarz spot işlemleri ve paritelerin temel analizlerini @midaskripto üzerinden değerlendirmek isterseniz aşağıdaki bağlantıdan hesap oluşturabilirsiniz.\n🔗https://t.co/f1MxTAPBDJ\n\nHerkese güzel bir hafta, bol kazançlar dilerim.\n#isbirligi",entity_set:$R[170]={__ref:"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set"},id:"Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA="},"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set":$R[171]={__id:"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set",__typename:"EntitySet",hashtags:$R[172]={__refs:$R[173]=["client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:hashtags:0"]},symbols:$R[174]={__refs:$R[175]=["client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:symbols:0"]},smarttags:null,urls:$R[176]={__refs:$R[177]=["client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:urls:0"]},user_mentions:$R[178]={__refs:$R[179]=["client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:hashtags:0":$R[180]={__id:"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[181]=[928,938],text:"isbirligi"},"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:symbols:0":$R[182]={__id:"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[183]=[0,4],tag:$R[184]={__ref:"U21hcnRUYWc6WFJQ"},text:"XRP"},"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:urls:0":$R[185]={__id:"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"app.midaskripto.com/UmaH/ysf8u51p",expanded_url:"https://app.midaskripto.com/UmaH/ysf8u51p",indices:$R[186]=[855,878],url:"https://t.co/f1MxTAPBDJ"},"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:user_mentions:0":$R[187]={__id:"client:Tm90ZVR3ZWV0OjE5ODgyODI4MzAwODI3ODUyODA=:entity_set:user_mentions:0",__typename:"ApiMentionEntity",indices:$R[188]=[757,769],is_unmentioned:null,screen_name:"midaskripto"},"client:VHdlZXQ6MTk4ODI4MjgzMDM0NjkzMjU0Ng==:grok_translated_post_with_availability":$R[189]={__id:"client:VHdlZXQ6MTk4ODI4MjgzMDM0NjkzMjU0Ng==:grok_tra