	let zone = timeZone;
	if (zone) try {
		new Intl.DateTimeFormat("en", { timeZone: zone }).format();
	} catch {
		zone = "UTC";
	}
	return `${new Intl.DateTimeFormat(lang, {
		hour: "numeric",
		minute: "2-digit",
		timeZone: zone
	}).format(date)} · ${new Intl.DateTimeFormat(lang, {
		month: "short",
		day: "numeric",
		year: "numeric",
		timeZone: zone
	}).format(date)}`;
