:$R[294]={__ref:"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:details:conversation_control"},created_at_ms:1769768141000,display_text_range:$R[295]=[0,276],self_thread_metadata:null,full_text:"#HYPE | Güncelleme\n\nMerhabalar,\nBelirlediğimiz dirençlerde onay yapıları sağlandıktan sonra short yönlü işlem aldım (4. ekran görüntüsünü confirmation'ı nasıl sağladığını görmek için kontrol edebilirsiniz).\n\nBelirlediğimiz desteğe gelince bu short yönlü işlemi kapatmak yerine https://t.co/xlR6NhSuF6",hashtag_entities:$R[296]={__refs:$R[297]=["client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:details:hashtag_entities:0"]},cashtag_entities:$R[298]={__refs:$R[299]=[]},smarttags:$R[300]={__refs:$R[301]=[]}},"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:details:conversation_control":$R[302]={__id:"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:details:conversation_control",__typename:"ApiConversationControl",policy:"Subscribers",conversation_owner_results:$R[303]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:details:hashtag_entities:0":$R[304]={__id:"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:details:hashtag_entities:0",__typename:"ApiTagEntity",indices:$R[305]=[0,5],text:"HYPE"},"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:views":$R[306]={__id:"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:views",__typename:"ViewCountInfo",count:"10981"},"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:note_tweet":$R[307]={__id:"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[308]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE3MTc5OTA0NDU0OTE4MTQ0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDE3MTc5OTA0NDU0OTE4MTQ0:$R[309]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE3MTc5OTA0NDU0OTE4MTQ0",__typename:"NoteTweetResults",result:$R[310]={__ref:"Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE3MTc5OTA0NDU0OTE4MTQ0"},"Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ=":$R[311]={__id:"Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ=",__typename:"NoteTweet",text:"#HYPE | Güncelleme\n\nMerhabalar,\nBelirlediğimiz dirençlerde onay yapıları sağlandıktan sonra short yönlü işlem aldım (4. ekran görüntüsünü confirmation'ı nasıl sağladığını görmek için kontrol edebilirsiniz).\n\nBelirlediğimiz desteğe gelince bu short yönlü işlemi kapatmak yerine hedge pozisyon olarak short yönlü işlemimin yarısı büyüklüğünde long işlemi aldım.\n\nDiğer belirlediğim destek olan $23.7’ye fiyat düşerse bir miktar daha long düşünüp aslında short pozisyonumu olabildiğince dipten realize etme planım mevcut.\n\nKendimi güvenceye almak adına short’un stop’unu entry bölgeme taşıdım. İki yönlü de güzel kurgular yarattığımız için her işlem tipi kârda olmalı, dileyen arkadaşlarımız komple kapatabilir. Ben, “pozisyon yönetiminiz nasıl?” sorularına bir projeksiyon vermiş olmak istedim.\n\nHerkese hayırlı cumalar, güzel günler dilerim.",entity_set:$R[312]={__ref:"client:Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ="},"client:Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ=:entity_set":$R[313]={__id:"client:Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ=:entity_set",__typename:"EntitySet",hashtags:$R[314]={__refs:$R[315]=["client:Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ=:entity_set:hashtags:0"]},symbols:$R[316]={__refs:$R[317]=[]},smarttags:null,urls:$R[318]={__refs:$R[319]=[]},user_mentions:$R[320]={__refs:$R[321]=[]}},"client:Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ=:entity_set:hashtags:0":$R[322]={__id:"client:Tm90ZVR3ZWV0OjIwMTcxNzk5MDQ0NTQ5MTgxNDQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[323]=[0,5],text:"HYPE"},"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:grok_translated_post_with_availability":$R[324]={__id:"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzNTE0Mw==:legacy":$R[325]={__id:"client:VHdlZXQ6MjAxNzE3OTkwNDY2NDUzN