VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[250]=[28,35],tag:$R[251]={__ref:"U21hcnRUYWc6RVRIQlRD"},text:"ETHBTC"},"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:details:cashtag_entities:1":$R[252]={__id:"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:details:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[253]=[37,43],tag:$R[254]={__ref:"U21hcnRUYWc6QlRDLkQ="},text:"BTC.D"},"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:views":$R[255]={__id:"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:views",__typename:"ViewCountInfo",count:"130883"},"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:note_tweet":$R[256]={__id:"client:VHdlZXQ6MTk4NTY1MzQyMTc0NDAwNTE0Nw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[257]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1NjUzNDIxMzI4Nzg5NTA0"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTg1NjUzNDIxMzI4Nzg5NTA0:$R[258]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1NjUzNDIxMzI4Nzg5NTA0",__typename:"NoteTweetResults",result:$R[259]={__ref:"Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTg1NjUzNDIxMzI4Nzg5NTA0"},"Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=":$R[260]={__id:"Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=",__typename:"NoteTweet",text:"Total Market Cap 1 & 2, $ETHBTC, $BTC.D | Update\n\nMerhabalar,\n\nBaşlıkta ismi geçen 4 paritenin marketin genel akıbetini okumak açısından önemli olduğu kanaatindeyim.\n\nGrafiklerimin üzerindeki tüm notlar geçmiş analizimde vurgu yaptığım bölgelerin notlarıdır.\n\nGeçtiğimiz analizde tüm önemsediğim bölgeleri kısaca yazmıştım, bu sefer yine önemsediğim bölgeler ve kazanımı/kaybı sonrası gelebilecek potansiyel direnç/destek bölgelerine de vurgu yapacağım. \n\nDilerim marketi okumanız açısından size ek bir fayda sağlar.\n\nTotal Market Cap\n\n$3.95 T bölgesindeki direnç alanı 2 defa çalıştı ve kâr realizasyonu veya terste kalan pozisyonlar için uyarı niteliğinde paylaşımlar yapıldı.\n\nGüncel destek bölgesi ara bir destek kısmı olan $3.36 T olarak gözüme çarpıyor.\nBu bölgenin destek görevini yerine getirememesi durumunda ise maalesef $3.11 bölgesinde yer alan RL olarak yazılı bölge destek görevi üstlenebilir.\n\nGüncel direnç bölgemiz RH yazan $3.63 T bölgesidir.\n\nSideways (yatay hareket) durumundan ötürü karışık bir fiyat aksiyonu gözlemlemiş olsak da $3.74 T bölgesinin kazanımının da markete pozitif etkisi olacağı kanaatindeyim.\n\nGünü yeşil kutunun üzerinde kapatması bullish fiyat aksiyonun genel akıbeti açısından faydalı olacaktır.\n\nTotal Market Cap 2\n\nDaha önce eldeki altcoin’lerin nerede realize edilmesi gerektiğine dair bir vurgu yapmıştım, grafik üzerindeki nottan gözlemleyebilirsiniz.\n\nGüncel direnç bölgesi kaybettiği kırmızı kutu ($1.45 T) olarak göze çarpıyor.\n\n$1.48 T seviyesinin kazanımı gerçekleşmeden tablo negatif gözüküyor.\n\nGüncel desteği grafik üzerindeki notta da belirtildiği gibi $1.30 T civarlarıdır.\n\nBu bölgenin efektif olmaması ve satış baskının devam etmesi durumunda ise maalesef öngörebildiğim destek $1.17 T civarlarıdır.\n\n#ETHBTC\n\n0.036 bölgesini direnç olarak belirlemiştik. Fiyat 0.037’den ret alarak maalesef aşağı yönlü hareketini başlattı.\n\nYO (Yearly Open / Yıllık Açılış) yazan yer kazanılmadığı müddetçe ETHBTC adına pozitif konuşmak mantıksız olacaktır.\nYO kazanımı gerçekleşirse bir diğer direnç olan 0.0382 gündeme gelecektir.\n\nUzunca süredir vurguladığım gibi, asıl altcoin rallisi vb senaryoların gündeme gelebilmesi için grafikte gördüğünüz kırmızı kutu/diyagonal trend çizgisi bölgelerinin geçilmesi gerekiyor, bu da #BTC.D ’de %57 seviyelerinin kaybı anlamına geliyor.\n\nGüncel destek bölgesi hakkında yorumumu da yine grafik üzerindeki notta görebilirsiniz.\n\n$BTC.D\n\n%59.2 bölgesinin destek görevi üstlenebileceğinden bahsetmiştik. Fiyat %59.02’den destek buldu.\n\nAn itibariyle %61.7 bölgesine hareketlenmiş gözüküyor. Kırmızı kutunun kazanımı marketin genel akıbeti açısından iyi olmayacaktır.\n\nO bölgeyi kazansa dahi ivedilikle deviasyon hareketi olarak sonlanması lazım ki pozitif senaryoları dile getirebilelim.\nGüncel desteği %60.1’dir.\n\n%59.2 bölgesinin kaybı ile %58 bölgesini gündeme alabiliriz.",entity_set:$R[261]={__ref:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set"},id:"Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ="},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set":$R[262]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set",__typename:"EntitySet",hashtags:$R[263]={__refs:$R[264]=["client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:1"]},symbols:$R[265]={__refs:$R[266]=["client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:2"]},smarttags:null,urls:$R[267]={__refs:$R[268]=[]},user_mentions:$R[269]={__refs:$R[270]=[]}},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:0":$R[271]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[272]=[1760,1767],text:"ETHBTC"},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:1":$R[273]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:hashtags:1",__typename:"ApiTagEntity",indices:$R[274]=[2270,2274],text:"BTC"},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:0":$R[275]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[276]=[24,31],tag:$R[277]={__ref:"U21hcnRUYWc6RVRIQlRD"},text:"ETHBTC"},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:1":$R[278]={__id:"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg3ODk1MDQ=:entity_set:symbols:1",__typename:"ApiTagEntity",indices:$R[279]=[33,39],tag:$R[280]={__ref:"U21hcnRUYWc6QlRDLkQ="},text:"BTC.D"},"client:Tm90ZVR3ZWV0OjE5ODU2NTM0MjEzMjg