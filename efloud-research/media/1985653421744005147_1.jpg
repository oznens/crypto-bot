ies2:3:original_info",__typename:"ApiMediaEntityOriginalInfo",width:3286,height:1770},"TweetResults:1970781216220569623":$R[173]={__id:"TweetResults:1970781216220569623",__typename:"TweetResults",rest_id:"1970781216220569623",id:"VHdlZXRSZXN1bHRzOjE5NzA3ODEyMTYyMjA1Njk2MjM="},"client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:details":$R[174]={__id:"client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:details",__typename:"TBirdData",display_text_range:$R[175]=[0,277],full_text:"Total Market Cap 1 &amp; 2, $ETHBTC, $BTC.D | Update\n\nÇoğu kişinin canı sıkkın olduğu için çeviriyle uğraşmayın diye direkt Türkçe analiz atacağım, market normalleşince olağan akışta devam edeceğim.\n\nToplu bir değerlendirme yapmak adına ilk başta spesifik olarak altcoin’lerden https://t.co/UE0IQ1LDcm",hashtag_entities:$R[176]={__refs:$R[177]=[]},cashtag_entities:$R[178]={__refs:$R[179]=["client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:details:cashtag_entities:0","client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:details:cashtag_entities:1"]},smarttags:$R[180]={__refs:$R[181]=[]},created_at_ms:1760192183000,self_thread_metadata:null},"client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:details:cashtag_entities:0":$R[182]={__id:"client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[183]=[28,35],tag:$R[184]={__ref:"U21hcnRUYWc6RVRIQlRD"},text:"ETHBTC"},U21hcnRUYWc6RVRIQlRD:$R[185]={__id:"U21hcnRUYWc6RVRIQlRD",__typename:"SmartTag",info:$R[186]={__ref:"client:U21hcnRUYWc6RVRIQlRD:info"},id:"U21hcnRUYWc6RVRIQlRD"},"client:U21hcnRUYWc6RVRIQlRD:info":$R[187]={__id:"client:U21hcnRUYWc6RVRIQlRD:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:details:cashtag_entities:1":$R[188]={__id:"client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:details:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[189]=[37,43],tag:$R[190]={__ref:"U21hcnRUYWc6QlRDLkQ="},text:"BTC.D"},"U21hcnRUYWc6QlRDLkQ=":$R[191]={__id:"U21hcnRUYWc6QlRDLkQ=",__typename:"SmartTag",info:$R[192]={__ref:"client:U21hcnRUYWc6QlRDLkQ=:info"},id:"U21hcnRUYWc6QlRDLkQ="},"client:U21hcnRUYWc6QlRDLkQ=:info":$R[193]={__id:"client:U21hcnRUYWc6QlRDLkQ=:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:note_tweet":$R[194]={__id:"client:VHdlZXQ6MTk3NzAxNTQyNjUwNTY1MDI2OQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[195]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTc3MDE1NDI2MTUzMzI4NjQw"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTc3MDE1NDI2MTUzMzI4NjQw:$R[196]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTc3MDE1NDI2MTUzMzI4NjQw",__typename:"NoteTweetResults",result:$R[197]={__ref:"Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTc3MDE1NDI2MTUzMzI4NjQw"},"Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=":$R[198]={__id:"Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=",__typename:"NoteTweet",text:"Total Market Cap 1 & 2, $ETHBTC, $BTC.D | Update\n\nÇoğu kişinin canı sıkkın olduğu için çeviriyle uğraşmayın diye direkt Türkçe analiz atacağım, market normalleşince olağan akışta devam edeceğim.\n\nToplu bir değerlendirme yapmak adına ilk başta spesifik olarak altcoin’lerden ziyade, başlıkta belirttiğim paritelerin analiz edilmesinin daha doğru olabileceğini düşünüyorum. Genel bir bias (öngörü) oluşturması adına daha tutarlı analizler yapabilmemizi sağlayacaktır böylece.\n\nBu arada sizlerden gelen istekler doğrultusunda bakacağım. Yoksa $0’a wick atmış paritelerin grafiklerini açıp da fikir beyan etmek bence ‘şimdilik’ pek mantıklı değil.\n\nGeçtiğimiz analizden olan ilgili notları grafik üzerinde görebilirsiniz.\n\nTotal Market Cap\n\nRH bölgesinin kaybının tekrar yeşil kutulu bölgenin biraz altını getirebilir ($3.40 T civarları).\n\nBir önceki destek bölgemiz olan $3.74 T bölgesinin kazanımı ise ilk aşamada $3.95 T civarlarını getirebilir.\n\nTotal Market Cap 2\n\nKırmızı kutulu bölge güncel destek alanımız. Fiyat orayı kaybederse $1.30 T civarları gelebilir.\n\nAltcoin’lerde bir artış görülürse (BTC.D’de bulunan destek seviyesine değineceğim) $1.56 T bölgesi direnç görevi üstlenebilir.\n\nO bölgedeki zayıflık emareleri ile alım yönlü işemlerden kâr realizasyonu düşünülebilir.\n\n#ETHBTC\n\nBu pariteye ve $BTC.D ’e genelde araştırma raporlarında değiniyorum. Mutlaka araştırma raporlarını okumanızı tavsiye ediyorum.\n\nDestek olarak belirlediğimiz bölgeden güzel bir reaksiyon aldı lakin yeterli değil.\n\n0.0353-0.036 bölgesinin direnç görevi üstlenebileceğini düşünüyorum.\n\n$ETH ve altcoin’lerin geneli için ilk pozitif emareleri 0.0382 bölgesinin kazanımı ile gerçekleşeceği kanaatindeyim. Herkesin beklediği altcoin sezonu ise 0.041 bölgesindeki kırmızı kutu ve 2022’den beri swing high’ları kullanarak belirlediğim diyagonal trend çizgisinin kırılımı sonrası gerçekleşecektir kanaatindeyim.\n\n0.032 - 0.03 bölgesi güncel destek konumunda. Bu görünüme bakarsak tekrar oraları test etme meyili devam ediyor. O bölgenin kaybını da yazmak istemiyorum doğrusu, olursa değinirim.\n\n$BTC.D\n\nKaybettiği kanalın alt bandı ile güncel direnç bölgesi olan kırmızı kutudan şimdilik ret almış gözüküyor.\n\nGüncel destek bölgesi %59.2 civarları olup (kırmızı kesikli çizgi), o bölgenin kaybı ile %58.1 seviyesinin gelebileceğini düşünüyorum.\n\n%57 kaybı ise $ETHBTC’de bahsettiğim 0.041 bölgesinin kazanımı ile eşdeğer bir akış şeması yaratabilir. Yani altcoin’ler için beklenen büyük aksiyonu takip etmeniz açısından bu seviyenin kaybını baz almanız mantıklı olacaktır.\n\nSon Notlar\n\nYüzdesel anlamda absürt kazançlar sağlayan bir profil olmadığım için kayıplardan da makul oranda etkileniyorum. Eğer bu işi sürdürülebilir kılmak ise amacınız, sizin de kazanç ve kayıp rasyonuzun pozisyona girmeden evvel belli ve makul ölçülerde olması gerektiğini tekrar hatırlatmak isterim.\n\nMillet uçup kaçarken izlemek size zor gelebilir - bazen ben de \"vay arkadaş 1000 dolara böyle kazanç mı olur\" diyorum ancak kendime edindiğim disiplin bu tip zamanlarda da beni ayakta tutabiliyor. Normal zamanlarda ise (yani 95%'den bahsediyorum) bakiyemi bulk’lamamı sağlıyor. Doğru yatırımlar ve mantıklı kâr realizasyonlarıyla da işi kumara dökmeden uzun vadede kazançlı çıkabiliyoruz.\n\nBunlar benim naçizane 9 yıla yakın trade ve yatırım serüvenimden elde ettiğim birkaç tecrübedir. Umarım size de fayda sağlar.\n\nBuraya ayırabilecek vaktim oldukça altcoin'lere ve sorularınıza dönüş yapmaya gayret edeceğim. Sağlıcakla kalın.\n\nHerkese güzel bir hafta sonu, bundan sonraki süreçte bol kazançlar diliyorum.",entity_set:$R[199]={__ref:"client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set"},id:"Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA="},"client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set":$R[200]={__id:"client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set",__typename:"EntitySet",hashtags:$R[201]={__refs:$R[202]=["client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:hashtags:0"]},symbols:$R[203]={__refs:$R[204]=["client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:symbols:3","client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:symbols:4"]},smarttags:null,urls:$R[205]={__refs:$R[206]=[]},user_mentions:$R[207]={__refs:$R[208]=[]}},"client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:hashtags:0":$R[209]={__id:"client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[210]=[1282,1289],text:"ETHBTC"},"client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:symbols:0":$R[211]={__id:"client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[212]=[24,31],tag:$R[213]={__ref:"U21hcnRUYWc6RVRIQlRD"},text:"ETHBTC"},"client:Tm90ZVR3ZWV0OjE5NzcwMTU0MjYxNTMzMjg2NDA=:entity_set:symbols:1":$R[214]={__id:"client:Tm90ZVR3