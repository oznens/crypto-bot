l6nYabUAAmiBq.jpg",type:"photo",indices:$R[158]=[282,305],id_str:"2024784324466528256",source_status_id_str:null,ext_alt_text:null,additional_media_info:null,original_info:$R[159]={__ref:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:media_entities2:2:original_info"},ext_playlists:$R[160]={__refs:$R[161]=[]},video_info:null,sensitive_media_warning:null},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:media_entities2:2:original_info":$R[162]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:media_entities2:2:original_info",__typename:"ApiMediaEntityOriginalInfo",width:1206,height:2622},"TweetResults:2022640411458625979":$R[163]={__id:"TweetResults:2022640411458625979",__typename:"TweetResults",rest_id:"2022640411458625979",id:"VHdlZXRSZXN1bHRzOjIwMjI2NDA0MTE0NTg2MjU5Nzk="},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details":$R[164]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details",__typename:"TBirdData",display_text_range:$R[165]=[0,281],full_text:"#XU100 &amp; $GARAN | Güncelleme &amp; Midas Kredi Özelliği\n\nMerhabalar,\n\nDün ciddi bir satış baskısı gören fiyat ile portföyümdeki GYO ve bankacılık sektöründe olan paritelerden kısmi kâr realizasyonu gerçekleştirdim. Yükseliş trendinin bozulduğunu henüz düşünmüyorum, ancak XU100 https://t.co/fh7EFBSocB",hashtag_entities:$R[166]={__refs:$R[167]=["client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:hashtag_entities:0"]},cashtag_entities:$R[168]={__refs:$R[169]=["client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:cashtag_entities:0"]},smarttags:$R[170]={__refs:$R[171]=[]},created_at_ms:1771581320000,self_thread_metadata:null},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:hashtag_entities:0":$R[172]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:hashtag_entities:0",__typename:"ApiTagEntity",indices:$R[173]=[0,6],text:"XU100"},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:cashtag_entities:0":$R[174]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[175]=[13,19],tag:$R[176]={__ref:"U21hcnRUYWc6R0FSQU4="},text:"GARAN"},"U21hcnRUYWc6R0FSQU4=":$R[177]={__id:"U21hcnRUYWc6R0FSQU4=",__typename:"SmartTag",info:$R[178]={__ref:"client:U21hcnRUYWc6R0FSQU4=:info"},id:"U21hcnRUYWc6R0FSQU4="},"client:U21hcnRUYWc6R0FSQU4=:info":$R[179]={__id:"client:U21hcnRUYWc6R0FSQU4=:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:note_tweet":$R[180]={__id:"client:VHdlZXQ6MjAyNDc4NDkyNzk2Nzg0NjgwNw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[181]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI0Nzg0OTI3NDcyODg5ODU2"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDI0Nzg0OTI3NDcyODg5ODU2:$R[182]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI0Nzg0OTI3NDcyODg5ODU2",__typename:"NoteTweetResults",result:$R[183]={__ref:"Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI0Nzg0OTI3NDcyODg5ODU2"},"Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=":$R[184]={__id:"Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=",__typename:"NoteTweet",text:"#XU100 & $GARAN | Güncelleme & Midas Kredi Özelliği\n\nMerhabalar,\n\nDün ciddi bir satış baskısı gören fiyat ile portföyümdeki GYO ve bankacılık sektöründe olan paritelerden kısmi kâr realizasyonu gerçekleştirdim. Yükseliş trendinin bozulduğunu henüz düşünmüyorum, ancak XU100 nezdinde bir şişkinlik olduğu aşikâr. Grafiğimde gördüğünüz yeşil kutulu bölgenin kaybı (güncel talep alanı) fiyatı bir nebze daha geri çekilmeye sebebiyet verebilir. Bu durumda ise Actual Gap yazan kısım alarmlı konumda.\n\nGeçtiğimiz güncellemede $GARAN kısmında 155 seviyesinden bahsetmiştim. Alıntılı post'tan kontrol edebilirsiniz.\n\nFiyat o bölgeye düşüp reaksiyon gösterse de üstte bahsettiğim sert satış baskısı sebebiyle yeni alımlarımı 156.4'den geri vermiş durumdayım.\n\nAyrıca, bu tip kısa vadeli veya gün içi işlemlerde bankada olan paramın müsait olmayışı vb. sebeplerle bazen hızlı aksiyon almam gerektiği durumlarda kullanılabilecek @getmidas'ın kredi sisteminden bahsetmek istiyorum. \n\nTemel olarak sistem, Borsa İstanbul’daki hisse işlemlerinde portföyünü teminat göstererek krediden faydalanıp daha büyük alım gücüyle yatırım yapmaya olanak sağlıyor.\n\nMidas Kredi Temel Özellikleri\nKolay ve hızlı: Midas uygulamasında birkaç tıkla krediyi aktif edebilirsin. Uzun onay süreçleri yok.\nPortföy teminatlı: Kullanabileceğin kredi limiti, portföyündeki varlıkların teminat değerine ve nakit bakiyene göre hesaplanır.\nYüksek alım gücü: Kredi dahil toplam alım gücün; nakit + kredi + portföy teminat değerlerinin toplamına göre yükselir.\nFaiz: Krediye genellikle yıllık %48–%63 civarında bir faiz uygulanır. Ancak aynı gün içinde krediyi kullanıp kapatırsan faiz ücretlendirmesi yapılmaz. Günlükte de faiz oranı %0.18 civarlarına denk geliyor. Yani 10.000 TL'ye günlük yaklaşık 18 TL ödersin. \nAlt limit: Kredili yatırımı aktifleştirebilmek  için portföy değerinin en az ₺75.000 olması gerekir.\n\nÖnemli: Krediyi aktifleştirsen bile kullanmadıkça faiz ödemezsin. Kullandığında da aynı gün kapattığında faiz ödemezsin. Ertesi güne taşırsan, günlük maliyet işlemeye başlar.\n\nDetaylar için: Midas uygulamasında Menü > Yatırım Hesabı > Türk Lirası bölümünden Kredili Yatırım özelliğine bakabilirsiniz.\nMidas uygulamasını indirmek için: https://t.co/KiIzyFAyMd\n\nBu sistemi kullanış şeklim:\nÇoğu kişi kredili işlemi duyunca aklına direkt \"nakitim yok, borçla hisse alayım\" geliyor ama benim kullanımım biraz farklı. Ben bunu daha çok bir köprü gibi görüyorum.\n\nTakip ettiğim bir hissede güzel bir giriş noktası yakaladım diyelim, almam lazım. Ama nakit o an hesapta değil, para piyasası fonunda ya da vadeli hesapta bekliyor. Normal şartlarda o paranın gelmesini bekleyene kadar fiyat çoktan gitmiş oluyor, sen de arkasından bakıyorsun.\n\nKredi limitim varken bu beklemeyi yaşamıyorum. Alımı yapıyorum, 2 gün sonra beklediğim nakit hesaba düştüğünde borcu kapatıyorum. Ödediğim 2-3 günlük faiz, o fırsatı o fiyattan yakalamanın bedeli oluyor. Yani ben krediyi bir kaldıraç aracı olarak değil, bir hızlandırıcı olarak kullanıyorum. Bu kafayla yaklaşınca insanın içi çok daha rahat oluyor açıkçası. Çünkü karşılığı olmayan bir parayı kullanmak, benim için her zaman tedirgin edici.\n\nBurada önemli bir not düşmek istiyorum: Bu tarz bir kullanım \"fırsat değerlendirme\" aracı olarak işe yarayabiliyor, evet. Ama arkasında mutlaka bir planınızın olması gerekiyor. Nakdiniz ne zaman gelecek, borcun vadesi ne, riskiniz ne kadar, bunların hepsini önceden bilmeniz lazım. Kredi sonuçta kredidir. Plansız kullanıldığında hızlandırıcı olmaktan çıkıp sizi zorlayan bir yüke dönüşebilir.\n\nNot: Burada yer alan yatırım bilgileri, yorumları ve tavsiyeleri yatırım danışmanlığı kapsamında değildir. Yatırım danışmanlığı hizmeti, yetkili kuruluşlar tarafından kişilerin risk ve getiri tercihleri dikkate alınarak kişiye özel sunulmaktadır. Burada yer alan bilgiler ise genel nitelikte olup raporda yer alan kişilerin yorum ve görüşlerini içermektedir. Bu tavsiyeler mali durumunuz ile risk ve getiri tercihlerinize uygun olmayabilir. Bu nedenle, sadece burada yer alan bilgilere dayanılarak yatırım kararı verilmesi beklentilerinize uygun sonuçlar doğurmayabilir.\n\n#isbirligi",entity_set:$R[185]={__ref:"client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY="},"client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set":$R[186]={__id:"client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set",__typename:"EntitySet",hashtags:$R[187]={__refs:$R[188]=["client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set:hashtags:1"]},symbols:$R[189]={__refs:$R[190]=["client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set:symbols:1"]},smarttags:null,urls:$R[191]={__refs:$R[192]=["client:Tm90ZVR3ZWV0OjIwMjQ3ODQ5Mjc0NzI4ODk4NTY=:entity_set:urls:0"]},user_m