wCountInfo",count:"35150"},"client:VHdlZXQ6MjA4ODE5MTg2OTg2ODAwNzUxMQ==:mention_entities:0":$R[179]={__id:"client:VHdlZXQ6MjA4ODE5MTg2OTg2ODAwNzUxMQ==:mention_entities:0",__typename:"ApiMentionEntity",id_str:"1271153110052941826",indices:$R[180]=[52,61],is_unmentioned:null,screen_name:"getmidas"},"client:VHdlZXQ6MjA4ODE5MTg2OTg2ODAwNzUxMQ==:note_tweet":$R[181]={__id:"client:VHdlZXQ6MjA4ODE5MTg2OTg2ODAwNzUxMQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[182]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDg4MTkxODY5NjIwNTI3MTA0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDg4MTkxODY5NjIwNTI3MTA0:$R[183]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDg4MTkxODY5NjIwNTI3MTA0",__typename:"NoteTweetResults",result:$R[184]={__ref:"Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDg4MTkxODY5NjIwNTI3MTA0"},"Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=":$R[185]={__id:"Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=",__typename:"NoteTweet",text:"$SKHY | Güncelleme\n\nMerhabalar,\n\nGeçtiğimiz ay size @getmidas'ın erken emir özelliğini tanıtarak SK Hynix projesinden bahsetmiştim. İçerik yaklaşık 100 kişi tarafından arşivlenmiş ve 40.000 kişiye ulaşmış. Bunlar ciddi miktarlar olduğu için, içeriğin ve paritenin takip edildiğini düşünerek aksiyonlarıma dair bir güncelleme paylaşmak istedim.\nİlgili post: https://t.co/Lbg4E9kJfA\n\nAyrıca post altında ve sorduğunuz sorularda direkt olarak nereden alım yapacağımı iletmiştim.\n1) https://t.co/EGbBM7fiNF\n2) https://t.co/THYJZnh61z\n\nÖzellikle alıntıladığım posttaki günden sonra fiyat $140 seviyesinin altında sadece 2 gün geçirip yükselişe başladı ve an itibarıyla %18 kârla ilerliyor.\n\n350 adet alım yapmıştım, bunların %50'sini satacağım. Kalanı da entry seviyeme düşerse kapatacak şekilde alarm kurup takibe alacağım. Böylece şimdilik yaklaşık $4500 dolarlık kârı realize etmiş olacağım.\n\nBu tarz bilgilendirmeleri, menkul değer paylaşımlarını daha sık görmek istiyorsanız ve analizlerimden benimle paralel olarak faydalanmak istiyorsanız aşağıdaki link'ten Midas'ın uygulamasını indirebilir ve istatistiki açıdan bana katkı sağlayabilirsiniz.\n\n🔗 https://t.co/dVtXYoxR2H\n\nHerkese trade'lerinde başarılar ve güzel bir gün diliyorum.\n\n#tanıtım",entity_set:$R[186]={__ref:"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ="},"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set":$R[187]={__id:"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set",__typename:"EntitySet",hashtags:$R[188]={__refs:$R[189]=["client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:hashtags:0"]},symbols:$R[190]={__refs:$R[191]=["client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:symbols:0"]},smarttags:$R[192]={__refs:$R[193]=[]},urls:$R[194]={__refs:$R[195]=["client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:urls:0","client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:urls:1","client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:urls:2","client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:urls:3"]},user_mentions:$R[196]={__refs:$R[197]=["client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:hashtags:0":$R[198]={__id:"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[199]=[1235,1243],text:"tanıtım"},"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:symbols:0":$R[200]={__id:"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[201]=[0,5],tag:$R[202]={__ref:"U21hcnRUYWc6U0tIWQ=="},text:"SKHY"},"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:urls:0":$R[203]={__id:"client:Tm90ZVR3ZWV0OjIwODgxOTE4Njk2MjA1MjcxMDQ=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"x.com/Efloud/status/…",expanded_url:"https://x.com/Efloud/status/2075196601715302440",indices:$R[204]=[357,380],url:"https://t.co/Lbg4E9kJf