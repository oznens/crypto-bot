jQyNzI2NzU2NA==:views",__typename:"ViewCountInfo",count:"112522"},"client:VHdlZXQ6MjA4NDcwMTcyNjQyNzI2NzU2NA==:note_tweet":$R[145]={__id:"client:VHdlZXQ6MjA4NDcwMTcyNjQyNzI2NzU2NA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[146]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDg0NzAxNzI2MTYyOTYwMzg0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDg0NzAxNzI2MTYyOTYwMzg0:$R[147]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDg0NzAxNzI2MTYyOTYwMzg0",__typename:"NoteTweetResults",result:$R[148]={__ref:"Tm90ZVR3ZWV0OjIwODQ3MDE3MjYxNjI5NjAzODQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDg0NzAxNzI2MTYyOTYwMzg0"},"Tm90ZVR3ZWV0OjIwODQ3MDE3MjYxNjI5NjAzODQ=":$R[149]={__id:"Tm90ZVR3ZWV0OjIwODQ3MDE3MjYxNjI5NjAzODQ=",__typename:"NoteTweet",text:"$BTC | LTF Güncelleme & Midas Atlas Kripto\n\nMerhabalar,\nKısaca fikirlerimden bahsedip kısa bir tanıtım yapacağım.\n\n$SPX'in ATH tazelemesi, $NQ'ın benim için önemli olan desteğini yeniden kazanması (analizlerimdeki yeşil kutu), petrol fiyatındaki elzem düşüş sebebiyle kripto tarafındaki bu sığ piyasada kısa vadeli spot işlem aldım.\n\nGrafiğimdeki MO kısmı kaybedilmedikçe problem görmüyorum ve fiyatı $64600 ile EQ bölgesine kadar sırasıyla kâr alarak taşıma planım mevcut.\n\nBu tip dönemlerde kısa vade trade'ler yaptığımın altını yeniden çizeyim. Hatta bunun sebebiyle ve istatistikî bilgileriyle birlikte yarın X üzerinden bir makale yayınlayacağım.\n\n$63350 seviyesinden aldığım işlemi @getmidas'ın geliştirdiği Atlas platformundan gerçekleştirdim. Mobilden trading işine benim gibi pek sıcak olmayan kişiler için gayet güzel ve yeterli bir arayüz oluşturduklarını söyleyebilirim.\n\nAşağıya işlemim ile ilgili görseli ve platformun arayüzünü bırakıyorum.\n\nSiz de Midas'ın Atlas platfomunu denemek isterseniz aşağıdaki link'ten üyelik açıp ardından Atlas'a erişebilirsiniz. Yakında Varant ve Vadeli İşlemler de gelecek.\n🔗https://t.co/np6VrQDx4r\n\nHerkese güzel bir hafta, trade'lerinde bol kazançlar dilerim.\n\n#tanıtım",entity_set:$R[150]={__ref:"client:Tm90ZVR3