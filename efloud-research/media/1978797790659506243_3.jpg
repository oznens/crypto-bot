 güzel bir gün, bol kazançlar dilerim 🤝",entity_set:$R[261]={__ref:"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set"},id:"Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg="},"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set":$R[262]={__id:"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set",__typename:"EntitySet",hashtags:$R[263]={__refs:$R[264]=[]},symbols:$R[265]={__refs:$R[266]=["client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:3"]},smarttags:null,urls:$R[267]={__refs:$R[268]=[]},user_mentions:$R[269]={__refs:$R[270]=[]}},"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:0":$R[271]={__id:"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[272]=[24,31],tag:$R[273]={__ref:"U21hcnRUYWc6RVRIQlRD"},text:"ETHBTC"},"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:1":$R[274]={__id:"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:1",__typename:"ApiTagEntity",indices:$R[275]=[33,39],tag:$R[276]={__ref:"U21hcnRUYWc6QlRDLkQ="},text:"BTC.D"},"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:2":$R[277]={__id:"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:2",__typename:"ApiTagEntity",indices:$R[278]=[342,348],tag:$R[279]={__ref:"U21hcnRUYWc6QlRDLkQ="},text:"BTC.D"},"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:3":$R[280]={__id:"client:Tm90ZVR3ZWV0OjE5Nzg3OTc3OTA1Mjk0ODY4NDg=:entity_set:symbols:3",__typename:"ApiTagEntity",indices:$R[281]=[408,415],tag:$R[282]={__ref:"U21hcnRUYWc6RVRIQlRD"},text:"ETHBTC"},"client:VHdlZXQ6MTk3ODc5Nzc5MDY1OTUwNjI0Mw==:grok_translated_post_with_availability":$R[283]={__id:"client:VHdlZXQ6MTk3ODc5Nzc5MDY1OTUwNjI0Mw==:grok_translated_