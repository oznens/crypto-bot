 market reversal gelebilir düşüncesindeydim. Her ne kadar $ETH destek olarak düşündüğüm bölgeden reaksiyon almış olsa bile bu sebeple bu paritede işlem alamadım.\n\nHer https://t.co/YYFzyJpYcl",hashtag_entities:$R[280]={__refs:$R[281]=[]},cashtag_entities:$R[282]={__refs:$R[283]=["client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:details:cashtag_entities:0","client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:details:cashtag_entities:1"]},smarttags:$R[284]={__refs:$R[285]=[]}},"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:details:cashtag_entities:0":$R[286]={__id:"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[287]=[71,75],tag:$R[288]={__ref:"U21hcnRUYWc6QlRD"},text:"BTC"},U21hcnRUYWc6QlRD:$R[289]={__id:"U21hcnRUYWc6QlRD",__typename:"SmartTag",info:$R[290]={__ref:"client:U21hcnRUYWc6QlRD:info"},id:"U21hcnRUYWc6QlRD"},"client:U21hcnRUYWc6QlRD:info":$R[291]={__id:"client:U21hcnRUYWc6QlRD:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[292]={__ref:"client:U21hcnRUYWc6QlRD:info:info"}},"client:U21hcnRUYWc6QlRD:info:info":$R[293]={__id:"client:U21hcnRUYWc6QlRD:info:info",__typename:"FinanceSmartTagInfo",ticker:"BTC"},"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:details:cashtag_entities:1":$R[294]={__id:"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:details:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[295]=[186,190],tag:$R[296]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:views":$R[297]={__id:"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:views",__typename:"ViewCountInfo",count:"11798"},"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:mention_entities:0":$R[298]={__id:"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:mention_entities:0",__typename:"ApiMentionEntity",id_str:"1777425517899067392",indices:$R[299]=[0,15],is_unmentioned:null,screen_name:"TheGunsslinger"},"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA==:note_tweet":$R[300]={__id:"client:VHdlZXQ6MjAxNTcyNjMzNDkxMjM4OTMyOA=