"]},smarttags:$R[188]={__refs:$R[189]=[]}},"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:details:cashtag_entities:0":$R[190]={__id:"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[191]=[0,4],tag:$R[192]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:views":$R[193]={__id:"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:views",__typename:"ViewCountInfo",count:"22873"},"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:note_tweet":$R[194]={__id:"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[195]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE1NzE2ODk5NDA1ODYwODY0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDE1NzE2ODk5NDA1ODYwODY0:$R[196]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE1NzE2ODk5NDA1ODYwODY0",__typename:"NoteTweetResults",result:$R[197]={__ref:"Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE1NzE2ODk5NDA1ODYwODY0"},"Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ=":$R[198]={__id:"Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ=",__typename:"NoteTweet",text:"$ETH LTF Update\n\n2938 altı 4H zaman diliminde kapanış gelmesi sonrası düşüş yönlü hızlı ve negatif ayrışarak ilerledi (-%4.5). \n\nShort işlemi alsam da, long tarafta yeşil çizginin süpürülmesini beklediğim için, BTC yeni low atarken nearly equal lows yapıp yükseldi. Ben de hakkımı diğer analizimden kullandım. \n\nKör emir atmadan ise yeşil kutuyu tekrar kazanması ile işleme girilebilirdi (%2.5) benim tercih ettiğim bir yapı değil, zira aşağıda fazla likidite bıraktı olası bir dönüşte 2766 - 2780 güzel bir yakıt olucak. \n\nGenel görünümde ise, lowlarla düşük zaman dilimlerinde likidite temizlikleri yapan yapı, dün itibariyle sert bir kayıp yaşadı, bu hareketin manipülasyon kalması için 2940 ve hızlıca YO / MO kurumsal seviyesi kazanılmalı.\n\n2860’ların ilgili zaman diliminde kaybı, tekrar satış baskısını arttıracaktır. \n\nFiyatlar genelinde bakış açımızı ne yazık ki düşük zaman dilimlerinde ilerletebildiğimiz için işlemlerden kar alıp, riski sıfırlamak ya da stop entry çekmek oldukça önemli. \n\nAna momentum bearish olduğundan LTF tepkileri değerlendirdiğimizi, HTF bir kırılım yaratacaksa bile bunu full size karşılayamayacağımızı unutmamak gerek.",entity_set:$R[199]={__ref:"client:Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ="},"client:Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ=:entity_set":$R[200]={__id:"client:Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ=:entity_set",__typename:"EntitySet",hashtags:$R[201]={__refs:$R[202]=[]},symbols:$R[203]={__refs:$R[204]=["client:Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ=:entity_set:symbols:0"]},smarttags:null,urls:$R[205]={__refs:$R[206]=[]},user_mentions:$R[207]={__refs:$R[208]=[]}},"client:Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ=:entity_set:symbols:0":$R[209]={__id:"client:Tm90ZVR3ZWV0OjIwMTU3MTY4OTk0MDU4NjA4NjQ=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[210]=[0,4],tag:$R[211]={__ref:"U21hcnRUYWc6RVRI"},text:"ETH"},"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:grok_translated_post_with_availability":$R[212]={__id:"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:legacy":$R[213]={__id:"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:legacy",__typename:"LegacyTweet",possibly_sensitive:!1,retweeted_status_results:null},"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:edit_control":$R[214]={__id:"client:VHdlZXQ6MjAxNTcxNjg5OTU0MDA1MDI4NA==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[215]=["2015716899540050284"]},"urt:server:TimelineTimelineEntry:tweet-2015726334912389328":$R[216]={__id:"urt:server:TimelineTimelineEntry:tweet-2015726334912389328",__typename:"TimelineTimelineEntry",entry_id:"tweet-2015726334912389328",sort_index:"2089459589966725110",content:$R[217]={__ref:"client: