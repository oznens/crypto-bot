HdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:core",__typename:"TweetCore",user_results:$R[190]={__ref:"VXNlclJlc3VsdHM6MTA2MzkzOTUwNTgyNzMyMzkwNA=="}},"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details":$R[191]={__id:"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details",__typename:"TBirdData",conversation_control:null,created_at_ms:1763835845000,display_text_range:$R[192]=[0,288],self_thread_metadata:null,full_text:"#XU100 &amp; $GARAN &amp; $ASELS | Güncelleme\n\nGeçtiğimiz analizden önem arz eden notları grafik üzerine ekledim.\n\nKırmızı kutunun momentumlu bir şekilde kırılması, piyasaya kayda değer bir para akışı girmesine yol açabilir. Ancak makro ölçekte tüm piyasalar negatif seyrediyorken BIST’in https://t.co/8ya8tWwbF3",hashtag_entities:$R[193]={__refs:$R[194]=["client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:hashtag_entities:0"]},cashtag_entities:$R[195]={__refs:$R[196]=["client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:cashtag_entities:0","client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:cashtag_entities:1"]},smarttags:$R[197]={__refs:$R[198]=[]}},"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:hashtag_entities:0":$R[199]={__id:"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:hashtag_entities:0",__typename:"ApiTagEntity",indices:$R[200]=[0,6],text:"XU100"},"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:cashtag_entities:0":$R[201]={__id:"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:cashtag_entities:0",__typename:"ApiTagEntity",indices:$R[202]=[13,19],tag:$R[203]={__ref:"U21hcnRUYWc6R0FSQU4="},text:"GARAN"},"U21hcnRUYWc6R0FSQU4=":$R[204]={__id:"U21hcnRUYWc6R0FSQU4=",__typename:"SmartTag",info:$R[205]={__ref:"client:U21hcnRUYWc6R0FSQU4=:info"},id:"U21hcnRUYWc6R0FSQU4="},"client:U21hcnRUYWc6R0FSQU4=:info":$R[206]={__id:"client:U21hcnRUYWc6R0FSQU4=:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:cashtag_entities:1":$R[207]={__id:"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:details:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[208]=[26,32],tag:$R[209]={__ref:"U21hcnRUYWc6QVNFTFM="},text:"ASELS"},"U21hcnRUYWc6QVNFTFM=":$R[210]={__id:"U21hcnRUYWc6QVNFTFM=",__typename:"SmartTag",info:$R[211]={__ref:"client:U21hcnRUYWc6QVNFTFM=:info"},id:"U21hcnRUYWc6QVNFTFM="},"client:U21hcnRUYWc6QVNFTFM=:info":$R[212]={__id:"client:U21hcnRUYWc6QVNFTFM=:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:views":$R[213]={__id:"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:views",__typename:"ViewCountInfo",count:"76026"},"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:note_tweet":$R[214]={__id:"client:VHdlZXQ6MTk5MjI5ODA1MzYxODA4MTg2OA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[215]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTkyMjk4MDUzMTYwODA0MzUy"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTkyMjk4MDUzMTYwODA0MzUy:$R[216]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTkyMjk4MDUzMTYwODA0MzUy",__typename:"NoteTweetResults",result:$R[217]={__ref:"Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTkyMjk4MDUzMTYwODA0MzUy"},"Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=":$R[218]={__id:"Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=",__typename:"NoteTweet",text:"#XU100 & $GARAN & $ASELS | Güncelleme\n\nGeçtiğimiz analizden önem arz eden notları grafik üzerine ekledim.\n\nKırmızı kutunun momentumlu bir şekilde kırılması, piyasaya kayda değer bir para akışı girmesine yol açabilir. Ancak makro ölçekte tüm piyasalar negatif seyrediyorken BIST’in tersine hareket etme ihtimali zayıf görünüyor. Bu nedenle işlemlerimi daha çok kısa vadeli aksiyonlar şeklinde almaktayım.\n\nDestek olarak belirttiğim yeşil kutunun kaybı ise #XU100 tarafında yeniden bir geri çekilme ve “vakit kaybı” diyebileceğimiz bir fazın başlamasına neden olabilir. \nBöyle bir durumda daha önce de bahsettiğim “Actual Gap” bölgesi (9141) dikkat edilmesi gereken alanlardan biri haline gelebilir.\n\n#GARANTI\n\nYine aynı flood’da (4. ekran görüntüsünden takip edebilirsiniz) belirttiğim üzere, alım fırsatı olarak öncü kategoride bankacılık sektörünü işaret etmiştim ($GARAN).\nBu parite yaklaşık %11’lik bir kâr marjı bıraktı ve hâlihazırda ana direncinin altında işlem görmeye devam ediyor.\n\nRange konseptini sevenler için: kırmızı kutu Range High, en alttaki yeşil kutu Range Low, mavi kutu ise Equilibrium olarak değerlendirilebilir.\n\nKısa vadede bir düzeltme gelmesi durumunda fiyata daha yakın konumdaki yeşil kutuya alarm kurmuş durumdayım. Bu bölgenin altındaki swing low seviyesinin kaybedilmemesi ise bullish senaryolar açısından önemlidir.\n\nBankacılık sektörünün genel endeksini ( $XBANK) takip etmenizde fayda var. 16300 (RH) ile 11350 (RL) seviyeleri arasında geniş bir range yapısı bulunmaktadır.\n\n#ASELSAN\n\nBir diğer önem arz eden sektör ise son ekran görüntüsünden de anlaşılacağı üzere savunma sanayi; burada $ASELS ’i baz aldım.\n\nBu paritede uzun süredir pozisyonum bulunduğu için yeni bir alım düşünmüyorum. \n\nTemel sebeplerden ötürü çok pesimist yaklaşmasam da 170 seviyesinin kaybı halinde portföyümdeki pozisyonu realize etmeyi planlıyorum. \nAyrıca 154 seviyesine alarm kuruyorum.\n\nEğer bu tarz analizlerin ve bakış açılarının size faydalı olduğunu düşünüyorsanız ve bu bilgileri daha derinlemesine incelemek istiyorsanız aşağıda vereceğim link üzerinden @getmidas uygulamasını indirebilirsiniz.\n\n🔗 https://t.co/9k0TACPS1i\n\nHerkese güzel bir hafta sonu, gelecek hafta alacağı trade’lerinde başarılar dilerim.\n\nNot: Burada yer alan yatırım bilgi, yorum ve tavsiyeleri yatırım danışmanlığı kapsamında değildir. Yatırım danışmanlığı hizmeti, yetkili kuruluşlar tarafından kişilerin risk ve getiri tercihleri dikkate alınarak kişiye özel sunulmaktadır. Burada yer alan bilgiler ise genel nitelikte olup raporda yer alan kişilerin yorum ve görüşlerini içermektedir. Bu tavsiyeler mali durumunuz ile risk ve getiri tercihlerinize uygun olmayabilir. Bu nedenle, sadece burada yer alan bilgilere dayanılarak yatırım kararı verilmesi beklentilerinize uygun sonuçlar doğurmayabilir.\n\n#isbirligi",entity_set:$R[219]={__ref:"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set"},id:"Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI="},"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set":$R[220]={__id:"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set",__typename:"EntitySet",hashtags:$R[221]={__refs:$R[222]=["client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:1","client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:2","client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:3","client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:4"]},symbols:$R[223]={__refs:$R[224]=["client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:symbols:3"]},smarttags:null,urls:$R[225]={__refs:$R[226]=["client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:urls:0"]},user_mentions:$R[227]={__refs:$R[228]=["client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:0":$R[229]={__id:"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[230]=[0,6],text:"XU100"},"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:1":$R[231]={__id:"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:1",__typename:"ApiTagEntity",indices:$R[232]=[455,461],text:"XU100"},"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:2":$R[233]={__id:"client:Tm90ZVR3ZWV0OjE5OTIyOTgwNTMxNjA4MDQzNTI=:entity_set:hashtags:2",__typename:"ApiTagEntity",indices:$R[234]=[699,707],text:"G