WE1S:info:info"}},"client:U21hcnRUYWc6WE1S:info:info":$R[153]={__id:"client:U21hcnRUYWc6WE1S:info:info",__typename:"FinanceSmartTagInfo",ticker:"XMR"},"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:note_tweet":$R[154]={__id:"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[155]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoxOTI3Njg5MTAzNTI2ODI1OTg0"}},Tm90ZVR3ZWV0UmVzdWx0czoxOTI3Njg5MTAzNTI2ODI1OTg0:$R[156]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTI3Njg5MTAzNTI2ODI1OTg0",__typename:"NoteTweetResults",result:$R[157]={__ref:"Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTI3Njg5MTAzNTI2ODI1OTg0"},"Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=":$R[158]={__id:"Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=",__typename:"NoteTweet",text:"$XMR | Final Update\n\nMerhabalar,\n\nAnalize Türkçe başladığım için Türkçe bitireyim istedim.\nAlıntıladığım post'dan adım adım geriye sararak grafiğin üzerinde 1-2-3-4 şeklinde etiketlediğim tüm notların olduğu paylaşımları kronolojik olarak gözlemleyebilirsiniz.\n\nAnaliz değildi, paylaşımlardan ve notlardan göreceğiniz üzere direkt sinyaldi.\n\nSizle paylaştığım andan itibaren 111% yükselen, ekleme yapacağımı ilettiğim yerden itibaren de 81% yükselen #XMR işlemimim tamamen sonlamıştır.\n\nSürece ve doğru aksiyonu doğru risk yönetimi ile birleştirmenin nasıl bir şey olduğunun çıktısıdır, istifade edememiş olanlar için bile güzel bir ders/öğreti niteliğindedir.\n\nTekrar bu coin'i ne zaman almayı düşünürsün sorusu da muhtemelen gelebilir. \nŞimdilik değil. Lakin ilk fazda $240-250 arasını alarmlıyorum.\n\nAyrıca bu coin'i, ilk Alpha Trading Summit katılımımda gizlilik projeleri altında değerlendirip bakiyemin bir kısmını ile sürpriz yapabileceğini düşündüğüm için tuttuğumu söyleyerek bir risk almıştım. Oraya katılanlarınız vardı, hatırlayabilirler. Sürpriz yaptı :)\n\nİlk Alpha Trader Summit'deki sunumumu ve değindiğim genel başlıkları gözlemlemek isterseniz: https://t.co/AOQ2sJNfs1\n\nHerkese güzel bir gün dilerim.",entity_set:$R[159]={__ref:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set"},id:"Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ="},"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set":$R[160]={__id:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set",__typename:"EntitySet",hashtags:$R[161]={__refs:$R[162]=["client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:hashtags:0"]},symbols:$R[163]={__refs:$R[164]=["client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:symbols:0"]},smarttags:null,urls:$R[165]={__refs:$R[166]=["client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:urls:0"]},user_mentions:$R[167]={__refs:$R[168]=[]}},"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:hashtags:0":$R[169]={__id:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[170]=[450,454],text:"XMR"},"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:symbols:0":$R[171]={__id:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[172]=[0,4],tag:$R[173]={__ref:"U21hcnRUYWc6WE1S"},text:"XMR"},"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:urls:0":$R[174]={__id:"client:Tm90ZVR3ZWV0OjE5Mjc2ODkxMDM1MjY4MjU5ODQ=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"x.com/EfloudTheSurfe…",expanded_url:"https://x.com/EfloudTheSurfer/status/1818336402439835649",indices:$R[175]=[1162,1185],url:"https://t.co/AOQ2sJNfs1"},"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:grok_translated_post_with_availability":$R[176]={__id:"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:views":$R[177]={__id:"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:views",__typename:"ViewCountInfo",count:"145221"},"client:VHdlZXQ6MTkyNzY4OTEwMzc3NDIwNDMxMQ==:counts":$R[178]={_