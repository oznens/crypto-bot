iTagEntity",indices:$R[274]=[0,5],tag:$R[275]={__ref:"U21hcnRUYWc6QUFWRQ=="},text:"AAVE"},"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:views":$R[276]={__id:"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:views",__typename:"ViewCountInfo",count:"18070"},"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:note_tweet":$R[277]={__id:"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[278]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE5Mzk4MzkxMjE0ODY2NDMy"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDE5Mzk4MzkxMjE0ODY2NDMy:$R[279]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE5Mzk4MzkxMjE0ODY2NDMy",__typename:"NoteTweetResults",result:$R[280]={__ref:"Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE5Mzk4MzkxMjE0ODY2NDMy"},"Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=":$R[281]={__id:"Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=",__typename:"NoteTweet",text:"$AAVE | Yeni Fikirler\n\nMerhabalar,\n\nMarket maalesef hâlâ çok tatsız, direkt alım düşüncesinde olabileceğim ve dönüş emarelerinde dair herhangi bir kondisyon yok. Bu sebeple, en baştan uyarımı yapmak istedim: Destek bölgelerine gelen fiyatlarda LTF’lerde confirmation (onay) yapıları görmeden alım yapmanız büyük risk teşkil edecektir.\n\n#AAVE nezdinde geçmiş paylaşımlarımdan kesitler bırakarak ilerlemek istedim çünkü uzun süredir bu pariteyi incelemiyorum ancak pariteye dair birçok beklentimi paylaşmıştım. An itibarıyla, herhangi bir pozisyonum bulunmuyor.\n\nGüncel Düşüncelerim:\nFiyatın kırmızı kutu ile gösterdiğim $129 bölgesini kırması sonrası kısa vadeli bir pozitifleşme durumu söz konusu olabilir.\n\nGüncel desteğini ($117) kaybederse alım için confirmation bakacağım ve alarmladığım kısım ilk aşamada $96 bölgesi olacaktır.\n\nAşağıdaki desteği zikretmek istemesem de $63 bölgesi  grafiğimde büyük bir çöküş görülürse diye alarmladığım yerlerden biridir.\n\nHerkese kolay gelsin, trade’lerinizde başarılar dilerim.",entity_set:$R[282]={__ref:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI="},"client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set":$R[283]={__id:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set",__typename:"EntitySet",hashtags:$R[284]={__refs:$R[285]=["client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set:hashtags:0"]},symbols:$R[286]={__refs:$R[287]=["client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set:symbols:0"]},smarttags:null,urls:$R[288]={__refs:$R[289]=[]},user_mentions:$R[290]={__refs:$R[291]=[]}},"client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set:hashtags:0":$R[292]={__id:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[293]=[336,341],text:"AAVE"},"client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set:symbols:0":$R[294]={__id:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzOTEyMTQ4NjY0MzI=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[295]=[0,5],tag:$R[296]={__ref:"U21hcnRUYWc6QUFWRQ=="},text:"AAVE"},"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:grok_translated_post_with_availability":$R[297]={__id:"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:legacy":$R[298]={__id:"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:legacy",__typename:"LegacyTweet",possibly_sensitive:!1,retweeted_status_results:null},"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:edit_control":$R[299]={__id:"client:VHdlZXQ6MjAxOTM5ODM5MTQxMTkyOTUxOA==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[300]=["2019398391411929518"]},"urt:server:TimelineTimelineEntry:conversationthread-2019399305329799615":$R[301]={__id:"urt:server:TimelineTimelineEntry:conversationthread-2019399305329799615",__typename:"TimelineTimelineEntry",entry_id:"conversationthread-2019399305329799615",sort_index:"2089458106634338284",content:$R[302]={__ref:"client:urt:serve