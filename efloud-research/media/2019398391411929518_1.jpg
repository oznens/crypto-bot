onfirmation bakmaktan zarar gelmez.\n\nMarket sert bir düzeltmeye daha giderse $147 bölgesi önemsediğim ve alarmladığım bölgelerden bir diğeridir.\n\n$240 seviyesi geçilmeden makro anlamda bir market kırılım yapısı görmeyeceğimiz için alımlarda temkinli ilerlemek sizin faydanıza olacaktır.\n\nHerkese trade'lerinde başarılar, bol kazançlar dilerim.",entity_set:$R[161]={__ref:"client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set"},id:"Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA="},"client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set":$R[162]={__id:"client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set",__typename:"EntitySet",hashtags:$R[163]={__refs:$R[164]=["client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set:hashtags:0"]},symbols:$R[165]={__refs:$R[166]=["client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set:symbols:0"]},smarttags:null,urls:$R[167]={__refs:$R[168]=[]},user_mentions:$R[169]={__refs:$R[170]=[]}},"client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set:hashtags:0":$R[171]={__id:"client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[172]=[58,63],text:"AAVE"},"client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set:symbols:0":$R[173]={__id:"client:Tm90ZVR3ZWV0OjE5ODY0MTY2OTQwMjIwODI1NjA=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[174]=[0,5],tag:$R[175]={__ref:"U21hcnRUYWc6QUFWRQ=="},text:"AAVE"},"client:VHdlZXQ6MTk4NjQxNjY5NDE5NDA0MTA0NA==:grok_translated_post_with_availability":$R[176]={__id:"client:VHdlZXQ6MTk4NjQxNjY5NDE5NDA0MTA0NA==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MTk4NjQxNjY5NDE5NDA0MTA0NA==:views":$R[177]={__id:"client:VHdlZXQ6MTk4NjQxNjY5NDE5NDA0MTA0NA==:views",__typename:"ViewCountInfo",count:"102319"},"client:VHdlZXQ6MTk4NjQxNjY5NDE5NDA0MTA0NA==:counts":$R[178]={__id:"client:VHdlZXQ6MTk4NjQxNjY5NDE5NDA0MTA0NA==:counts",__typename:"ApiCounts",reply_count:14,f