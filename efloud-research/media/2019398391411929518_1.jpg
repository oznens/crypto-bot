nd success in their trades.\n\nFor the Turkish🇹🇷 analysis 👇 or join free Telegram channel: https://t.co/6uG0VNJrNe\n\n1/2",entity_set:$R[203]={__ref:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA="},"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set":$R[204]={__id:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set",__typename:"EntitySet",hashtags:$R[205]={__refs:$R[206]=["client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:hashtags:0"]},symbols:$R[207]={__refs:$R[208]=["client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:symbols:0"]},smarttags:null,urls:$R[209]={__refs:$R[210]=["client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:urls:0"]},user_mentions:$R[211]={__refs:$R[212]=[]}},"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:hashtags:0":$R[213]={__id:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[214]=[376,381],text:"AAVE"},"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:symbols:0":$R[215]={__id:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[216]=[0,5],tag:$R[217]={__ref:"U21hcnRUYWc6QUFWRQ=="},text:"AAVE"},"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:urls:0":$R[218]={__id:"client:Tm90ZVR3ZWV0OjIwMTkzOTgzODMwMjc1MTU0MDA=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"t.me/+FGqEd-MlKNszM…",expanded_url:"https://t.me/+FGqEd-MlKNszMTA0",indices:$R[219]=[1155,1178],url:"https://t.co/6uG0VNJrNe"},"client:VHdlZXQ6MjAxOTM5ODM4MzM0MjA4ODU0Mw==:grok_translated_post_with_availability":$R[220]={__id:"client:VHdlZXQ6MjAxOTM5ODM4MzM0MjA4ODU0Mw==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjAxOTM5ODM4MzM0MjA4ODU0Mw==:legacy":$R[221]={__id:"client:VHdlZXQ6MjAxOTM5ODM4MzM0MjA4ODU0Mw==:legacy",__typename:"LegacyTweet",possibly_sensitive:!