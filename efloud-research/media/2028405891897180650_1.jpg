Tag",info:$R[164]={__ref:"client:U21hcnRUYWc6QlRD:info"},id:"U21hcnRUYWc6QlRD"},"client:U21hcnRUYWc6QlRD:info":$R[165]={__id:"client:U21hcnRUYWc6QlRD:info",__typename:"FinanceGetSmartTagInfoResponse",info:$R[166]={__ref:"client:U21hcnRUYWc6QlRD:info:info"}},"client:U21hcnRUYWc6QlRD:info:info":$R[167]={__id:"client:U21hcnRUYWc6QlRD:info:info",__typename:"FinanceSmartTagInfo",ticker:"BTC"},"client:VHdlZXQ6MjAyODAxNTg4ODg5NzYzNDc3Mw==:note_tweet":$R[168]={__id:"client:VHdlZXQ6MjAyODAxNTg4ODg5NzYzNDc3Mw==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[169]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI4MDE1ODg4NjQ1OTIyODE3"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDI4MDE1ODg4NjQ1OTIyODE3:$R[170]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI4MDE1ODg4NjQ1OTIyODE3",__typename:"NoteTweetResults",result:$R[171]={__ref:"Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDI4MDE1ODg4NjQ1OTIyODE3"},"Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=":$R[172]={__id:"Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=",__typename:"NoteTweet",text:"$BTC | LTF Position Update & New Ideas\n\nBana kalırsa, marketi çok iyi okuduğum ancak bundan #BTC nezdinde tam anlamıyla istifade edemediğim bir durum oldu. Bunun tek sebebi de savaşın çıkmış olması maalesef. Ancak fikirlerimi & pozisyonumu paylaştığım için gelen sorulara da genel bir cevap olması niteliğinde bu analizi ve durum değerlendirmesini yapmak istedim. Ek olarak da Beklenti başlığı altında yeni düşüncemi yazdım.\n\nYakın Geçmiş & Güncel Durum:\n$BTC PWO civarlarından short'landı. EQ'da kâr alındı. EQ'nun biraz altında kapatılıp long'a dönülecekti.\nAncak short'umu kapatmadım. Haliyle long'a dönmek de istemedim.\n\nBu analizlerimin tamamını & beklentilerimi alıntıladığım post'ta, Telegram'da ve X üzerinden paylaştığım makalede görebilirsiniz: https://t.co/SRyPKNkSnB\n\nLong almayı istememin sebebini LTF grafiğinin üzerinde olan nottan ve HTF grafiğinin üzerindeki nottan görebilirsiniz. X'teki makalemden kesintiler yaparak özet niteliğinde gösterdim.\n\nAnaliz mükemmel işlese bile, para kazanamadıktan sonra maalesef sadece yazıya dökülmüş hayal kırıklığı olarak bünyede yer ediniyor.\n\nBaşka pozisyonlar yakaladım, beklediğim yerlere geldiler ve yükseldiler. Ancak her zaman en yüksek parayı $BTC'den kazandığım için bakiye anlamında +'da olsam da beni mutlu eden bir serüven yok doğrusu.\n\nBeklenti:\nEQ bölgesine doğru bir geri çekilme sonrası göreceğim confirmation'lar bana yeni pozisyon kurgulamamda fikirler verebilir.\n\n(Kendime) Not:\nNe olursa olsun, planına - şunca yıllık oluşturulan tecrübeye uymalısın. Kaybedeceğin, en kötü, 1R-2R olur. Oluşturduğum altyapı bu 1-2R'ı risk edebilecek seviyede.\n\nTemenni:\nYurtta sulh, cihanda sulh. \nBüyüksün Atam. Dün bir kere daha anladım.\n\nHerkese güzel bir hafta sonu, harika bir yeni ay ve trader'lerinde başarılar dilerim. İyi pazarlar.",entity_set:$R[173]={__ref:"client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set"},id:"Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc="},"client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set":$R[174]={__id:"client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set",__typename:"EntitySet",hashtags:$R[175]={__refs:$R[176]=["client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set:hashtags:0"]},symbols:$R[177]={__refs:$R[178]=["client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set:symbols:2"]},smarttags:null,urls:$R[179]={__refs:$R[180]=["client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set:urls:0"]},user_mentions:$R[181]={__refs:$R[182]=[]}},"client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set:hashtags:0":$R[183]={__id:"client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[184]=[92,96],text:"BTC"},"client:Tm90ZVR3ZWV0OjIwMjgwMTU4ODg2NDU5MjI4MTc=:entity_set:symbols:0":$R[185]={__id:"client:Tm90ZVR3ZWV